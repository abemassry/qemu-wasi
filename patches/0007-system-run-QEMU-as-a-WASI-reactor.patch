 }
 
+#ifdef WASI_PLATFORM
+/*
+ * Debugging aid for long headless runs: QEMU_STATUS_EVERY=<secs> prints the
+ * vCPU state, the code around its pc and the most recent TBs every <secs>
+ * seconds of wall-clock time.
+ */
+static void wasi_status_dump(void)
+{
+    static int64_t status_every_ms = -1;
+    static int64_t next_status_ms;
+    int64_t now;
+    vaddr pc;
+    uint8_t code[96];
+    int i;
+
+    if (status_every_ms < 0) {
+        const char *env = getenv("QEMU_STATUS_EVERY");
+        status_every_ms = env ? atoi(env) * 1000LL : 0;
+    }
+    if (status_every_ms == 0 || !first_cpu) {
+        return;
+    }
+    now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    if (now < next_status_ms) {
+        return;
+    }
+    next_status_ms = now + status_every_ms;
+
+    pc = first_cpu->cc->get_pc(first_cpu);
+    fprintf(stderr, "QEMU_STATUS: t=%" PRId64 "ms halted=%d "
+            "interrupt_request=0x%x\n", now, first_cpu->halted,
+            first_cpu->interrupt_request);
+    cpu_dump_state(first_cpu, stderr, 0);
+    if (cpu_memory_rw_debug(first_cpu, pc - 16, code, sizeof(code),
+                            false) == 0) {
+        fprintf(stderr, "QEMU_STATUS: code at pc-16:");
+        for (i = 0; i < (int)sizeof(code); i++) {
+            fprintf(stderr, "%s%02x", i == 16 ? " | " : " ", code[i]);
+        }
+        fprintf(stderr, "\n");
+    }
+    fprintf(stderr, "QEMU_STATUS: exit_request=%d icount_decr=0x%08x "
+            "exception_index=%d cflags_next_tb=0x%08x\n",
+            first_cpu->exit_request, first_cpu->neg.icount_decr.u32,
+            first_cpu->exception_index, first_cpu->cflags_next_tb);
+    {
+        /*
+         * Raw stack words, for mapping return addresses to symbols offline.
+         * The stack pointer is read via the gdbstub register interface so
+         * this stays target-independent (register 7 is RSP on x86-64).
+         */
+        g_autoptr(GByteArray) reg = g_byte_array_new();
+        uint64_t sp = 0, words[32];
+
+        if (first_cpu->cc->gdb_read_register &&
+            first_cpu->cc->gdb_read_register(first_cpu, reg, 7) == 8) {
+            memcpy(&sp, reg->data, 8);
+            sp = le64_to_cpu(sp);
+            if (cpu_memory_rw_debug(first_cpu, sp, words, sizeof(words),
+                                    false) == 0) {
+                fprintf(stderr, "QEMU_STATUS: stack at 0x%" PRIx64 ":", sp);
+                for (i = 0; i < 32; i++) {
+                    fprintf(stderr, "%s%016" PRIx64, i % 4 ? " " : "\n  ",
+                            le64_to_cpu(words[i]));
+                }
+                fprintf(stderr, "\n");
+            }
+        }
+    }
+    {
+        extern void tb_history_dump(FILE *f);
+        extern void wasi_tb_exec_report(FILE *f);
+        tb_history_dump(stderr);
+        wasi_tb_exec_report(stderr);
+    }
+}
+
+/*
+ * Run one iteration of the main loop: service timers, bottom halves and fds
+ * without blocking, then run the vCPU for one time slice.  There are no
+ * threads on WASI, so the vCPU is driven inline from here.
+ *
+ * Returns true, with *status set, once QEMU should exit.  Used both by
+ * qemu_main_loop() and by the wasi_qemu_step() reactor export, which lets
+ * the host regain control between iterations.
+ */
+bool qemu_main_loop_step(int *status)
+{
+    extern void wasi_rr_cpu_step(void);
+
+    if (main_loop_should_exit(status)) {
+        return true;
+    }
+    extern void wasi_prof_add_loop(int64_t loop_ns, int64_t cpu_ns);
+    extern void wasi_prof_report_maybe(void);
+    int64_t t0, t1, t2;
+
+    wasi_status_dump();
+    wasi_prof_report_maybe();
+    t0 = get_clock();
+    /* Only wait for timers when no vCPU has anything to do. */
+    main_loop_wait(!all_cpu_threads_idle());
+#ifndef CONFIG_SLIRP
+    /* Hand frames from the host's user network to the NIC (net/wasi-user.c.inc). */
+    wasi_net_poll();
+#endif
+    t1 = get_clock();
+    wasi_rr_cpu_step();
+    /* No RCU reader is active between iterations (see rcu.c). */
+    rcu_run_callbacks_inline();
+    t2 = get_clock();
+    wasi_prof_add_loop(t1 - t0, t2 - t1);
+    return false;
+}
+
+int qemu_main_loop(void)
+{
+    int status = EXIT_SUCCESS;
+
+    while (!qemu_main_loop_step(&status)) {
+        /* keep going */
+    }
+    return status;
+}
+#else
 int qemu_main_loop(void)
 {
     int status = EXIT_SUCCESS;
@@ -828,6 +964,7 @@ int qemu_main_loop(void)
 
     return status;
 }
+#endif
 
 void qemu_add_exit_notifier(Notifier *notify)
 {
