diff --git a/monitor/monitor.c b/monitor/monitor.c
index db52a9c..5bd643b 100644
--- a/monitor/monitor.c
+++ b/monitor/monitor.c
@@ -718,6 +718,18 @@ void monitor_init_globals(void)
      * have commands assuming that context.  It would be nice to get
      * rid of those assumptions.
      */
+#ifdef WASI_PLATFORM
+    /*
+     * WASI coroutines cannot suspend (see util/coroutine-wasi.c): yield
+     * returns immediately.  The QMP dispatcher waits for requests by
+     * yielding, so it would spin and trip its "busy" assertion.  QMP is
+     * therefore unavailable on WASI; the HMP monitor does not need the
+     * dispatcher.  Leaving qmp_dispatcher_co NULL is safe: wakes are no-ops
+     * because qmp_dispatcher_co_busy starts out true, and monitor_cleanup()
+     * stops waiting once qmp_dispatcher_co is NULL.
+     */
+    return;
+#endif
     qmp_dispatcher_co = qemu_coroutine_create(monitor_qmp_dispatcher_co, NULL);
     aio_co_schedule(iohandler_get_aio_context(), qmp_dispatcher_co);
 }
diff --git a/system/main.c b/system/main.c
index 9b91d21..7536fc4 100644
--- a/system/main.c
+++ b/system/main.c
@@ -42,8 +42,85 @@ int qemu_default_main(void)
 
 int (*qemu_main)(void) = qemu_default_main;
 
+#ifdef WASI_PLATFORM
+#include <wasi/api.h>
+#include "sysemu/runstate.h"
+
+/*
+ * WASI reactor entry points.
+ *
+ * The wasm build is linked as a WASI "reactor" (-mexec-model=reactor): the
+ * host calls _initialize (constructors), then wasi_qemu_init() once, then
+ * wasi_qemu_step() repeatedly.  Returning to the host between main loop
+ * iterations leaves no wasm frames on the stack, which lets the host move
+ * the whole instance into a fresh wasmtime Store by copying linear memory.
+ * That is the only way to free the per-TB JIT modules, which a Store keeps
+ * alive until it is dropped.  After such a move the host calls
+ * wasi_qemu_jit_reset() because every compiled-TB handle is gone.
+ */
+__attribute__((export_name("wasi_qemu_init")))
+int wasi_qemu_init(void)
+{
+    __wasi_size_t argc, buf_size;
+    char **argv;
+    char *buf;
+
+    if (__wasi_args_sizes_get(&argc, &buf_size) != 0) {
+        return 1;
+    }
+    /* QEMU keeps pointers into argv, so these are never freed. */
+    argv = calloc(argc + 1, sizeof(char *));
+    buf = malloc(buf_size ? buf_size : 1);
+    if (!argv || !buf || __wasi_args_get((uint8_t **)argv, (uint8_t *)buf)) {
+        return 1;
+    }
+    for (__wasi_size_t i = 0; i < argc; i++) {
+        WASI_LOG("WASI_DBG: argv[%u]=%s\n", (unsigned)i, argv[i]);
+    }
+    qemu_init(argc, argv);
+    return 0;
+}
+
+/* Run one main loop iteration.  Returns -1 to continue, else exit status. */
+__attribute__((export_name("wasi_qemu_step")))
+int wasi_qemu_step(void)
+{
+    int status;
+
+    if (!qemu_main_loop_step(&status)) {
+        return -1;
+    }
+    qemu_cleanup(status);
+    return status < 0 ? 1 : status;
+}
+
+/* All JIT module handles were invalidated by the host. */
+__attribute__((export_name("wasi_qemu_jit_reset")))
+void wasi_qemu_jit_reset(void)
+{
+    extern void wasi_tb_cache_forget_all(void);
+    wasi_tb_cache_forget_all();
+}
+
+/*
+ * Ask QEMU to quit, as closing its window would: the guest is powered off,
+ * and disk images are flushed and closed so that they stay consistent.  The
+ * host keeps calling wasi_qemu_step() until it returns an exit status.
+ */
+__attribute__((export_name("wasi_qemu_quit")))
+void wasi_qemu_quit(void)
+{
+    qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_UI);
+}
+#endif /* WASI_PLATFORM */
+
 int main(int argc, char **argv)
 {
+    WASI_LOG("WASI_DBG: main() entered, argc=%d\n", argc);
+    for (int i = 0; i < argc; i++) {
+        WASI_LOG("WASI_DBG: argv[%d]=%s\n", i, argv[i]);
+    }
     qemu_init(argc, argv);
+    WASI_LOG("WASI_DBG: qemu_init returned, calling qemu_main\n");
     return qemu_main();
 }
