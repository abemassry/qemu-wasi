diff --git a/net/wasi-user.c.inc b/net/wasi-user.c.inc
new file mode 100644
index 0000000..cd90662
--- /dev/null
+++ b/net/wasi-user.c.inc
@@ -0,0 +1,175 @@
+/*
+ * User-mode networking (-netdev user, -nic user) for WASI builds
+ *
+ * WASI builds have no libslirp; the host runtime provides the network
+ * instead.  This backend hands every Ethernet frame the guest sends to the
+ * host, and polls the host for frames to deliver to the guest.  The host
+ * side (m-browser's qemu_net.rs) emulates the usual user-mode network:
+ * the guest gets 10.0.2.15 by DHCP, 10.0.2.2 is the gateway (the host) and
+ * 10.0.2.3 the DNS server, and traffic is relayed through host sockets.
+ *
+ * Host imports, from the "env" module:
+ *
+ *   int32_t host_net_send(const void *frame, int32_t len)
+ *       Pass one frame from the guest to the host's network.
+ *
+ *   int32_t host_net_recv(void *buf, int32_t size)
+ *       Copy the next frame for the guest into buf and return its length,
+ *       or return 0 if there is none.
+ *
+ *   void host_net_wait(int64_t timeout_ns)
+ *       Sleep for up to timeout_ns, but return as soon as a frame for the
+ *       guest is ready.
+ *
+ *   int32_t host_net_hostfwd(const char *rule, int32_t len)
+ *       Forward a host port into the guest, for a hostfwd option:
+ *       "[tcp]:[hostaddr]:hostport-[guestaddr]:guestport".  Returns 0, or
+ *       -1 after printing why the rule cannot be used.
+ *
+ * There are no file descriptors to wait on, so the main loop calls
+ * wasi_net_poll() on every iteration, and sleeps with host_net_wait() while
+ * the guest is idle so that replies are delivered without delay.
+ *
+ * Included from net.c, so that adding it needs no change to the meson
+ * build (this cross build cannot be reconfigured unattended).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+extern int32_t host_net_send(const void *frame, int32_t len);
+extern int32_t host_net_recv(void *buf, int32_t size);
+extern void host_net_wait(int64_t timeout_ns);
+extern int32_t host_net_hostfwd(const char *rule, int32_t len);
+
+typedef struct WasiUserState {
+    NetClientState nc;
+    /*
+     * A frame is waiting in the NIC's queue because the guest's receive
+     * ring is full: fetch no more from the host until it has been taken.
+     */
+    bool blocked;
+    uint8_t buf[NET_BUFSIZE];
+} WasiUserState;
+
+/* The host provides a single network, so there is at most one backend. */
+static WasiUserState *wasi_user;
+
+static ssize_t wasi_user_receive(NetClientState *nc, const uint8_t *buf,
+                                 size_t size)
+{
+    /* Like a wire, the host network may drop a frame it cannot handle. */
+    host_net_send(buf, size);
+    return size;
+}
+
+static void wasi_user_cleanup(NetClientState *nc)
+{
+    wasi_user = NULL;
+    wasi_idle_wait = NULL;
+}
+
+static NetClientInfo net_wasi_user_info = {
+    .type = NET_CLIENT_DRIVER_USER,
+    .size = sizeof(WasiUserState),
+    .receive = wasi_user_receive,
+    .cleanup = wasi_user_cleanup,
+};
+
+static void wasi_user_send_completed(NetClientState *nc, ssize_t len)
+{
+    DO_UPCAST(WasiUserState, nc, nc)->blocked = false;
+}
+
+/* Sleep while the guest is idle, waking early when a frame arrives for it. */
+static void wasi_user_idle_wait(int64_t ns)
+{
+    if (wasi_user && wasi_user->blocked) {
+        /*
+         * The NIC has no room: waking for frames waiting at the host would
+         * only spin, as they cannot be delivered yet.
+         */
+        struct timespec ts = { .tv_sec = 0, .tv_nsec = ns };
+
+        nanosleep(&ts, NULL);
+    } else {
+        host_net_wait(ns);
+    }
+}
+
+void wasi_net_poll(void)
+{
+    WasiUserState *s = wasi_user;
+
+    while (s && !s->blocked) {
+        int32_t len = host_net_recv(s->buf, sizeof(s->buf));
+
+        if (len <= 0) {
+            break;
+        }
+        if (qemu_send_packet_async(&s->nc, s->buf, len,
+                                   wasi_user_send_completed) == 0) {
+            s->blocked = true;
+        }
+    }
+}
+
+/* The first option given that the host network does not implement. */
+static const char *wasi_user_unsupported_option(const NetdevUserOptions *u)
+{
+    return u->hostname ? "hostname" :
+           (u->has_q_restrict && u->q_restrict) ? "restrict=on" :
+           (u->has_ipv4 && !u->ipv4) ? "ipv4=off" :
+           (u->has_ipv6 && u->ipv6) ? "ipv6=on" :
+           u->ip ? "ip" :
+           u->net ? "net" :
+           u->host ? "host" :
+           u->tftp ? "tftp" :
+           u->bootfile ? "bootfile" :
+           u->dhcpstart ? "dhcpstart" :
+           u->dns ? "dns" :
+           u->dnssearch ? "dnssearch" :
+           u->domainname ? "domainname" :
+           u->ipv6_prefix ? "ipv6-prefix" :
+           u->has_ipv6_prefixlen ? "ipv6-prefixlen" :
+           u->ipv6_host ? "ipv6-host" :
+           u->ipv6_dns ? "ipv6-dns" :
+           u->smb ? "smb" :
+           u->smbserver ? "smbserver" :
+           u->guestfwd ? "guestfwd" :
+           u->tftp_server_name ? "tftp-server-name" :
+           NULL;
+}
+
+static int net_init_wasi_user(const Netdev *netdev, const char *name,
+                              NetClientState *peer, Error **errp)
+{
+    const char *unsupported;
+    NetClientState *nc;
+    StringList *fwd;
+
+    assert(netdev->type == NET_CLIENT_DRIVER_USER);
+    unsupported = wasi_user_unsupported_option(&netdev->u.user);
+    if (unsupported) {
+        error_setg(errp, "user network option '%s' is not supported: "
+                   "the WASI host provides a fixed network", unsupported);
+        return -1;
+    }
+    if (wasi_user) {
+        error_setg(errp, "only one user network is supported");
+        return -1;
+    }
+    for (fwd = netdev->u.user.hostfwd; fwd; fwd = fwd->next) {
+        const char *rule = fwd->value->str;
+
+        if (host_net_hostfwd(rule, strlen(rule)) != 0) {
+            error_setg(errp, "could not set up host forwarding rule '%s'", rule);
+            return -1;
+        }
+    }
+
+    nc = qemu_new_net_client(&net_wasi_user_info, peer, "user", name);
+    qemu_set_info_str(nc, "net=10.0.2.0/24, provided by the WASI host");
+    wasi_user = DO_UPCAST(WasiUserState, nc, nc);
+    wasi_idle_wait = wasi_user_idle_wait;
+    return 0;
+}
