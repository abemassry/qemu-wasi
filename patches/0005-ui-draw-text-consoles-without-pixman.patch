diff --git a/ui/meson.build b/ui/meson.build
index 28c7381..948f09a 100644
--- a/ui/meson.build
+++ b/ui/meson.build
@@ -19,7 +19,9 @@ system_ss.add(files(
   'ui-qmp-cmds.c',
   'util.c',
 ))
-system_ss.add(when: pixman, if_true: files('console-vc.c'), if_false: files('console-vc-stubs.c'))
+# WASI build: pixman-minimal implements enough compositing to draw the text
