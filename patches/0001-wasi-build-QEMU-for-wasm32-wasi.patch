+static inline int dup2(int oldfd, int newfd) { (void)oldfd; (void)newfd; return -1; }
+static inline int ioctl(int fd, unsigned long request, ...) { (void)fd; (void)request; return -1; }
+static inline int mkstemp(char *tmpl) { (void)tmpl; return -1; }
+static inline int sigwait(const void *set, int *sig) { (void)set; (void)sig; return -1; }
+#ifndef _WASI_WAITPID_STUB
