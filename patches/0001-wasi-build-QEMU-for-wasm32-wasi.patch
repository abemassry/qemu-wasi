+#define SO_KEEPALIVE  9
+#endif
+#ifndef SO_REUSEADDR
+#define SO_REUSEADDR  2
+#endif
+#ifndef SO_ERROR
+#define SO_ERROR      4
+#endif
+#ifndef IP_MULTICAST_IF
+#define IP_MULTICAST_IF 32
+#endif
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL  0x4000
+#endif
+#ifndef MSG_DONTWAIT
+#define MSG_DONTWAIT  0x40
