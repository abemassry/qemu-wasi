diff --git a/util/mmap-alloc.c b/util/mmap-alloc.c
index ed14f9c..bfbb5b6 100644
--- a/util/mmap-alloc.c
+++ b/util/mmap-alloc.c
@@ -244,6 +244,42 @@ static inline size_t mmap_guard_pagesize(int fd)
 #endif
 }
 
+#if defined(__wasi__) || defined(WASI_PLATFORM)
+/*
+ * WASI: Use aligned_alloc instead of mmap.
+ * WASI's emulated mmap (from -D_WASI_EMULATED_MMAN) doesn't support
+ * MAP_FIXED or partial munmap, both of which qemu_ram_mmap relies on.
+ */
+void *qemu_ram_mmap(int fd,
+                    size_t size,
+                    size_t align,
+                    uint32_t qemu_map_flags,
+                    off_t map_offset)
+{
+    void *ptr;
+    size_t alloc_size;
+
+    (void)fd;
+    (void)qemu_map_flags;
+    (void)map_offset;
+
+    /* aligned_alloc requires size to be a multiple of alignment */
+    alloc_size = ROUND_UP(size, align);
+    ptr = aligned_alloc(align, alloc_size);
+    if (!ptr) {
+        return MAP_FAILED;
+    }
+    memset(ptr, 0, alloc_size);
+    return ptr;
+}
+
+void qemu_ram_munmap(int fd, void *ptr, size_t size)
+{
+    (void)fd;
+    (void)size;
+    free(ptr);
+}
+#else /* !WASI */
 void *qemu_ram_mmap(int fd,
                     size_t size,
                     size_t align,
@@ -301,3 +337,4 @@ void qemu_ram_munmap(int fd, void *ptr, size_t size)
         munmap(ptr, size + mmap_guard_pagesize(fd));
     }
 }
+#endif /* WASI */
