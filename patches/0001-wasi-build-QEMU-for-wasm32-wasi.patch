+#ifndef _WASI_SIGACTION_DEFINED
+#define _WASI_SIGACTION_DEFINED
+struct sigaction {
+    void (*sa_handler)(int);
+    void (*sa_sigaction)(int, siginfo_t *, void *);
+    unsigned long sa_mask;
+    int sa_flags;
+};
+#define SA_SIGINFO 0
+#define SA_RESTART 0
+#define SA_RESETHAND 0
+static inline int sigaction(int signum, const struct sigaction *act,
+                            struct sigaction *oldact) {
+    (void)signum; (void)act; (void)oldact;
+    return 0;
+}
+static inline int sigemptyset(unsigned long *set) {
+    if (set) *set = 0;
+    return 0;
+}
+static inline int sigfillset(unsigned long *set) {
+    if (set) *set = ~0UL;
+    return 0;
+}
+static inline int sigaddset(unsigned long *set, int signum) {
+    if (set) *set |= (1UL << signum);
+    return 0;
+}
+static inline int sigdelset(unsigned long *set, int signum) {
+    if (set) *set &= ~(1UL << signum);
+    return 0;
