diff --git a/include/qemu/osdep.h b/include/qemu/osdep.h
index fe7c3c5..9884458 100644
--- a/include/qemu/osdep.h
+++ b/include/qemu/osdep.h
@@ -131,9 +131,82 @@ QEMU_EXTERN_C int daemon(int, int);
 /* setjmp must be declared before sysemu/os-win32.h
  * because it is redefined there. */
 #include <setjmp.h>
+#ifdef __wasi__
+/*
+ * WASI has no signal mask — map sigsetjmp/siglongjmp to setjmp/longjmp
+ * so the compiler generates proper wasm sjlj try_table at call sites.
+ * Without this, the function stubs break wasm sjlj by double-wrapping
+ * the setjmp ID: the outer try_table gets one ID, the inner stub's
+ * setjmp overwrites jmp_buf with a different ID, and longjmp's throw
+ * is never caught by the outer try_table.
+ * (Same approach as os-win32.h:89-90)
+ */
+#undef sigsetjmp
+#undef siglongjmp
+#define sigsetjmp(env, savemask)  setjmp(env)
+#define siglongjmp(env, val)      longjmp(env, val)
+#endif /* __wasi__ sigsetjmp/siglongjmp macros */
 #include <signal.h>
 
-#ifdef CONFIG_IOVEC
+#ifdef __wasi__
+/* WASI has no termios.h — use our wasi-stubs/termios.h from include path */
