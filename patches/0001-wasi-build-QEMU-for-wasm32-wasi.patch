diff --git a/include/qemu/wasi-debug.h b/include/qemu/wasi-debug.h
new file mode 100644
index 0000000..2e69bdc
--- /dev/null
+++ b/include/qemu/wasi-debug.h
@@ -0,0 +1,63 @@
+/*
+ * Gated debug logging for the WASI/wasm build of QEMU.
+ *
+ * Bringing QEMU up under wasm needed a lot of progress tracing, but printing
+ * it unconditionally floods the terminal (and slows the guest, since some of
+ * it sits on the translation-block path).  These macros keep the probes in
+ * the source but silent by default.
+ *
+ * Control with the WASI_DEBUG environment variable:
+ *   unset / 0  quiet (only real warnings and errors)
+ *   1          startup and lifecycle tracing (qemu_init, device reset, ...)
+ *   2          adds per-translation-block and per-iteration tracing, which
+ *              is extremely verbose and noticeably slows execution
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QEMU_WASI_DEBUG_H
+#define QEMU_WASI_DEBUG_H
+
+#ifdef WASI_PLATFORM
+
+#include <stdio.h>
+#include <stdlib.h>
+
+static inline int wasi_debug_level(void)
+{
+    static int level = -1;
+
+    if (level < 0) {
+        const char *env = getenv("WASI_DEBUG");
+        level = env ? atoi(env) : 0;
+        if (level < 0) {
+            level = 0;
+        }
+    }
+    return level;
+}
+
+/* Lifecycle tracing: enabled at WASI_DEBUG=1 and above. */
+#define WASI_LOG(...)                                   \
+    do {                                                \
+        if (wasi_debug_level() >= 1) {                  \
+            fprintf(stderr, __VA_ARGS__);               \
+        }                                               \
+    } while (0)
+
+/* Hot-path tracing: enabled only at WASI_DEBUG=2 and above. */
+#define WASI_LOG_V(...)                                 \
+    do {                                                \
+        if (wasi_debug_level() >= 2) {                  \
+            fprintf(stderr, __VA_ARGS__);               \
+        }                                               \
+    } while (0)
+
+#else /* !WASI_PLATFORM */
+
+#define WASI_LOG(...)    do { } while (0)
+#define WASI_LOG_V(...)  do { } while (0)
+
+#endif /* WASI_PLATFORM */
+
+#endif /* QEMU_WASI_DEBUG_H */
