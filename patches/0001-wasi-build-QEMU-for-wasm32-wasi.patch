+/*
+ * Network function stubs.
+ * With -D__wasilibc_use_wasip2, the sysroot provides proper function
+ * declarations for socket/bind/listen/etc. We only need macro redirects
+ * if those declarations are NOT available.
+ */
+#ifndef __wasilibc_use_wasip2
+/* Without wasip2, provide inline stubs with macro redirects */
+static inline int qemu_wasi_socket(int domain, int type, int protocol) { (void)domain; (void)type; (void)protocol; return -1; }
+static inline int qemu_wasi_bind(int sockfd, const struct sockaddr *addr, socklen_t addrlen) { (void)sockfd; (void)addr; (void)addrlen; return -1; }
+static inline int qemu_wasi_listen(int sockfd, int backlog) { (void)sockfd; (void)backlog; return -1; }
+static inline int qemu_wasi_accept(int sockfd, struct sockaddr *addr, socklen_t *addrlen) { (void)sockfd; (void)addr; (void)addrlen; return -1; }
+static inline int qemu_wasi_connect(int sockfd, const struct sockaddr *addr, socklen_t addrlen) { (void)sockfd; (void)addr; (void)addrlen; return -1; }
+static inline ssize_t qemu_wasi_sendmsg(int sockfd, const struct msghdr *msg, int flags) { (void)sockfd; (void)msg; (void)flags; return -1; }
+static inline ssize_t qemu_wasi_recvmsg(int sockfd, struct msghdr *msg, int flags) { (void)sockfd; (void)msg; (void)flags; return -1; }
+static inline int qemu_wasi_socketpair(int domain, int type, int protocol, int sv[2]) { (void)domain; (void)type; (void)protocol; (void)sv; return -1; }
+#define socket   qemu_wasi_socket
+#define bind     qemu_wasi_bind
+#define listen   qemu_wasi_listen
+#define accept   qemu_wasi_accept
+#define connect  qemu_wasi_connect
+#define sendmsg  qemu_wasi_sendmsg
+#define recvmsg  qemu_wasi_recvmsg
+#define socketpair qemu_wasi_socketpair
+#endif /* !__wasilibc_use_wasip2 */
+
+/* DNS function stubs */
+static inline int getaddrinfo(const char *node, const char *service, const struct addrinfo *hints, struct addrinfo **res) { (void)node; (void)service; (void)hints; (void)res; return EAI_FAIL; }
+static inline void freeaddrinfo(struct addrinfo *res) { (void)res; }
+static inline const char *gai_strerror(int errcode) { (void)errcode; return "not supported"; }
+static inline int getnameinfo(const struct sockaddr *sa, socklen_t salen, char *host, socklen_t hostlen, char *serv, socklen_t servlen, int flags) { (void)sa; (void)salen; (void)host; (void)hostlen; (void)serv; (void)servlen; (void)flags; return -1; }
