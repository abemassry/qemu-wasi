diff --git a/crypto/random-platform.c b/crypto/random-platform.c
index f92f969..2726ca9 100644
--- a/crypto/random-platform.c
+++ b/crypto/random-platform.c
@@ -23,6 +23,40 @@
 #include "crypto/random.h"
 #include "qapi/error.h"
 
+#ifdef WASI_PLATFORM
+/*
+ * WASI platform: use getentropy() which is backed by __wasi_random_get.
+ * No /dev/urandom, no getrandom(), no file descriptors needed.
+ */
+#include <unistd.h>
+
+int qcrypto_random_init(Error **errp)
+{
+    /* getentropy() is always available on WASI — nothing to init */
+    (void)errp;
+    return 0;
+}
+
+int qcrypto_random_bytes(void *buf,
+                         size_t buflen,
+                         Error **errp)
+{
+    /* getentropy() can handle at most 256 bytes per call */
+    unsigned char *p = buf;
+    while (buflen > 0) {
+        size_t chunk = buflen > 256 ? 256 : buflen;
+        if (getentropy(p, chunk) != 0) {
+            error_setg_errno(errp, errno, "getentropy failed");
+            return -1;
+        }
+        p += chunk;
+        buflen -= chunk;
+    }
+    return 0;
+}
+
+#else /* !WASI_PLATFORM */
+
 #ifdef _WIN32
 #include <wincrypt.h>
 static HCRYPTPROV hCryptProv;
@@ -112,3 +146,5 @@ int qcrypto_random_bytes(void *buf,
 #endif
     return 0;
 }
+
+#endif /* WASI_PLATFORM */
