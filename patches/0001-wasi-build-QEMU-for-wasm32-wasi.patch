diff --git a/util/coroutine-wasi.c b/util/coroutine-wasi.c
new file mode 100644
index 0000000..a049d9b
--- /dev/null
+++ b/util/coroutine-wasi.c
@@ -0,0 +1,140 @@
+/*
+ * WASI Coroutine Backend for QEMU — Synchronous Direct-Call
+ *
+ * On WASI (single-threaded, no true stack switching), coroutines are
+ * implemented by calling the entry function directly within
+ * qemu_coroutine_switch(). This works because:
+ *
+ * 1. WASI has no I/O multiplexing — all _co_ functions are synchronous
+ *    (lseek, fstat, read, write complete immediately)
+ * 2. Single-threaded — no lock contention, so bdrv_graph_co_rdlock()
+ *    always takes the fast path (no yield needed)
+ * 3. The entry function runs to completion and returns, so
+ *    qemu_coroutine_switch returns COROUTINE_TERMINATE
+ *
+ * If a _co_ function tries to yield (qemu_coroutine_yield), that
+ * calls qemu_coroutine_switch with COROUTINE_YIELD. On WASI, the
+ * BH callback has already run synchronously (via inline execution
+ * in aio_bh_schedule_oneshot), so we restore state and return
+ * COROUTINE_YIELD to let qemu_coroutine_yield() return normally.
+ *
+ * Copyright (c) 2024 WASI QEMU Project
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.0 of the License, or (at your option) any later version.
+ */
+
+#undef _FORTIFY_SOURCE
+#define _FORTIFY_SOURCE 0
+
+#include "qemu/osdep.h"
+#include "qemu/coroutine_int.h"
+#include "qemu/coroutine-tls.h"
+
+/*
+ * Minimal CoroutineWasi — just wraps the base Coroutine.
+ * No asyncify buffers, no setjmp buffers, no stack allocation.
+ */
+typedef struct {
+    Coroutine base;
+} CoroutineWasi;
+
+/*
+ * Per-thread coroutine bookkeeping.
+ * WASI is single-threaded, but we use the standard TLS macros
+ * for compatibility with the rest of QEMU's coroutine code.
+ */
+QEMU_DEFINE_STATIC_CO_TLS(Coroutine *, current);
+QEMU_DEFINE_STATIC_CO_TLS(CoroutineWasi, leader);
+
+Coroutine *qemu_coroutine_new(void)
+{
+    CoroutineWasi *co = g_malloc0(sizeof(*co));
+    return &co->base;
+}
+
+void qemu_coroutine_delete(Coroutine *co_)
+{
+    CoroutineWasi *co = DO_UPCAST(CoroutineWasi, base, co_);
+    g_free(co);
+}
+
+/*
+ * qemu_coroutine_switch — Synchronous direct-call implementation.
+ *
+ * COROUTINE_ENTER: Call the entry function directly. The entry runs
+ * to completion (no yields). Returns COROUTINE_TERMINATE.
+ *
+ * COROUTINE_YIELD: Should never happen in this backend. If it does,
+ * it means an async code path was hit that we haven't handled.
+ * Abort with a diagnostic message.
+ */
+CoroutineAction __attribute__((noinline))
+qemu_coroutine_switch(Coroutine *from_, Coroutine *to_,
+                      CoroutineAction action)
+{
+    set_current(to_);
+
+    if (action == COROUTINE_ENTER) {
+        /*
+         * Call entry function directly. It will:
+         *   - Run the _co_ function (e.g., bdrv_co_refresh_total_sectors)
+         *   - Set poll_state.in_progress = false
+         *   - Call aio_wait_kick()
+         *   - Return
+         */
+        to_->entry(to_->entry_arg);
+
+        /* Restore current to caller */
+        set_current(from_);
+
+        return COROUTINE_TERMINATE;
+    }
+
+    if (action == COROUTINE_YIELD) {
+        /*
+         * WASI synchronous yield handling.
+         *
+         * This is reached when a generated coroutine wrapper (e.g.,
+         * bdrv_co_open_child in block-gen.c) does:
+         *   aio_bh_schedule_oneshot(ctx, bh_cb, &s);
+         *   qemu_coroutine_yield();
+         *
+         * On WASI, the BH callback runs synchronously (inline) before
+         * yield is called, so s->ret is already set. We just need to
+         * "return from yield" so the wrapper can read s->ret and continue.
+         *
+         * At this point, set_current(to_) at the top of this function
+         * has already changed current to the leader. We need to undo
+         * that: restore current to the coroutine (from_), and restore
+         * from_->caller which qemu_coroutine_yield() cleared.
+         */
+        set_current(from_);
+        from_->caller = to_;
+        return COROUTINE_YIELD;
+    }
+
+    fprintf(stderr, "qemu_coroutine_switch: unexpected action %d\n", action);
+    abort();
+}
+
+Coroutine *qemu_coroutine_self(void)
+{
+    Coroutine *self = get_current();
+    CoroutineWasi *leaderp = get_ptr_leader();
+
+    if (!self) {
+        self = &leaderp->base;
+        set_current(self);
+    }
+    return self;
+}
+
+bool qemu_in_coroutine(void)
+{
+    Coroutine *self = get_current();
+
+    return self && self->caller;
+}
diff --git a/util/event_notifier-posix.c b/util/event_notifier-posix.c
index 76420c5..478ed19 100644
--- a/util/event_notifier-posix.c
+++ b/util/event_notifier-posix.c
@@ -15,6 +15,86 @@
 #include "qemu/event_notifier.h"
 #include "qemu/main-loop.h"
 
+#ifdef WASI_PLATFORM
+/*
+ * WASI memory-based event notifier.
+ *
+ * WASI has no eventfd, no pipe(), and no Unix domain sockets.
+ * In single-threaded WASI mode, an event notifier is purely a flag:
+ *   - event_notifier_set()            -> sets the flag
+ *   - event_notifier_test_and_clear() -> reads & clears the flag
+ *
+ * We assign fake fd numbers (starting at 1000) so that callers storing
+ * the fd (e.g. in GPollFD / AioHandler) get a non-negative integer that
+ * won't collide with real WASI file descriptors (which start from 3).
+ * These fds are never actually passed to any syscall.
+ */
+
+/* Simple per-notifier flag stored via the fd value trick:
+ * rfd holds the fake fd, wfd holds the "signaled" state (0 or 1). */
+
+static int next_fake_fd = 1000;
+
+void event_notifier_init_fd(EventNotifier *e, int fd)
+{
+    e->rfd = fd;
+    e->wfd = 0; /* not signaled */
+    e->initialized = true;
+}
+
+int event_notifier_init(EventNotifier *e, int active)
+{
+    e->rfd = next_fake_fd++;
+    e->wfd = 0; /* not signaled */
+    e->initialized = true;
+    if (active) {
+        event_notifier_set(e);
+    }
+    return 0;
+}
+
+void event_notifier_cleanup(EventNotifier *e)
+{
+    if (!e->initialized) {
+        return;
+    }
+    e->rfd = -1;
+    e->wfd = 0;
+    e->initialized = false;
+}
+
+int event_notifier_get_fd(const EventNotifier *e)
+{
+    return e->rfd;
+}
+
+int event_notifier_get_wfd(const EventNotifier *e)
+{
+    return e->rfd; /* same fake fd for both read/write */
+}
+
+int event_notifier_set(EventNotifier *e)
+{
+    if (!e->initialized) {
+        return -1;
+    }
+    e->wfd = 1; /* signal */
+    return 0;
+}
+
+int event_notifier_test_and_clear(EventNotifier *e)
+{
+    int value;
+    if (!e->initialized) {
+        return 0;
+    }
+    value = e->wfd;
+    e->wfd = 0; /* clear */
+    return value;
+}
+
+#else /* !WASI_PLATFORM — original POSIX implementation */
+
 #ifdef CONFIG_EVENTFD
 #include <sys/eventfd.h>
 #endif
@@ -140,3 +220,5 @@ int event_notifier_test_and_clear(EventNotifier *e)
 
     return value;
 }
+
+#endif /* WASI_PLATFORM */
