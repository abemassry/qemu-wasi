+#ifdef WASI_THREADS
+/*
+ * vCPU threads on WASI.
+ *
+ * The host runs the TBs of each vCPU thread in a wasmtime Store of the
+ * thread's own, and replaces that Store from time to time: a Store keeps
+ * every TB module instantiated in it until it is dropped (see m-browser's
+ * qemu_threads.rs).  It can only be dropped while the thread has no frames
+ * in it, so the thread does not run the vCPU loop below itself.  It asks the
+ * host to run it (host_vcpu_run), and the host calls wasi_vcpu_step(), one
+ * iteration of the loop, again and again, each time through
+ * wasi_vcpu_enter() (tcg/wasm32.c) of the vCPU's current Store, until the
+ * vCPU is unplugged.  That Store's wasm instance shares this thread's stack
+ * (below this frame) and thread-local storage.
+ */
+
+/* Host import: run the vCPU of this thread; returns when it is unplugged. */
+extern void host_vcpu_run(int32_t cpu_index, uint32_t stack_top,
+                          uint32_t tls_base);
+
+/* wasi_vcpu_step() flags, from the host */
+#define WASI_VCPU_JIT_RESET 1   /* the vCPU's Store is new: forget all TBs */
+
+extern void wasi_tb_cache_forget_all(void);
+
+int wasi_vcpu_step(int flags);
+int wasi_vcpu_step(int flags)
+{
+    CPUState *cpu = current_cpu;
+    int done;
+
+    if (flags & WASI_VCPU_JIT_RESET) {
+        wasi_tb_cache_forget_all();
+    }
+
+    bql_lock();
+    if (cpu_can_run(cpu)) {
+        int r;
+
+        bql_unlock();
+        r = tcg_cpu_exec(cpu);
+        bql_lock();
+        switch (r) {
+        case EXCP_DEBUG:
+            cpu_handle_guest_debug(cpu);
+            break;
+        case EXCP_HALTED:
+            break;
+        case EXCP_ATOMIC:
+            bql_unlock();
+            cpu_exec_step_atomic(cpu);
+            bql_lock();
+            break;
+        default:
+            break;
+        }
+    }
+    qatomic_set_mb(&cpu->exit_request, 0);
+    qemu_wait_io_event(cpu);
+    done = cpu->unplug && !cpu_can_run(cpu);
+    bql_unlock();
+    return done;
+}
+
+static void __attribute__((noinline)) wasi_vcpu_thread_run(CPUState *cpu)
+{
+    /*
+     * The vCPU's instance runs on this thread's stack below this frame,
+     * which is the last one above it: give it the stack from just below.
+     */
+    volatile uint8_t here;
+    uint32_t stack_top = ((uintptr_t)&here - 64) & ~(uintptr_t)15;
+
+    host_vcpu_run(cpu->cpu_index, stack_top,
+                  (uint32_t)(uintptr_t)__builtin_wasm_tls_base());
+}
+#endif /* WASI_THREADS */
+
