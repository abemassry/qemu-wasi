diff --git a/hw/intc/apic.c b/hw/intc/apic.c
index 4186c57..274ba73 100644
--- a/hw/intc/apic.c
+++ b/hw/intc/apic.c
@@ -771,10 +771,35 @@ int apic_accept_pic_intr(DeviceState *dev)
     return 0;
 }
 
+#ifdef WASI_THREADS
+/*
+ * The guest's tick is this timer, and under emulation each tick costs a
+ * busy guest thousands of instructions: about half of all its time at 1000
+ * ticks a second.  Fire the timer on a grid of QEMU_TICK_SLACK_MS (default
+ * 30 ms) instead, which the guest sees as late ticks.  (The single-threaded
+ * WASI build gets the same effect from running the vCPU in time slices.)
+ */
+static int64_t apic_timer_slack(int64_t t)
+{
+    static int64_t slack = -1;
+
+    if (slack < 0) {
+        const char *env = getenv("QEMU_TICK_SLACK_MS");
+
+        slack = (env ? atoll(env) : 30) * SCALE_MS;
+    }
+    return slack > 0 ? QEMU_ALIGN_UP(t, slack) : t;
+}
+#endif
+
 static void apic_timer_update(APICCommonState *s, int64_t current_time)
 {
     if (apic_next_timer(s, current_time)) {
+#ifdef WASI_THREADS
+        timer_mod(s->timer, apic_timer_slack(s->next_time));
+#else
         timer_mod(s->timer, s->next_time);
+#endif
     } else {
         timer_del(s->timer);
     }
