     }
 }
 
+#elif defined(__wasm__)
+
+/* WebAssembly has no instruction cache; flush is a no-op */
+void flush_idcache_range(uintptr_t rx, uintptr_t rw, size_t len)
+{
+    (void)rx; (void)rw; (void)len;
+}
