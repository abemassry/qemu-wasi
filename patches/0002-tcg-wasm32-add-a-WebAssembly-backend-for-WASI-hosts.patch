+/*
+ * Call registered helper number func_idx, whose arguments are already on
+ * the operand stack.  The helper's C function pointer is its index in
+ * QEMU's function table, which the TB module imports as table 0, and its
+ * signature is type func_idx + 1 (type 0 is the TB entry function).
+ */
+static void tcg_out_op_call_helper(TCGContext *s, int func_idx)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+
+    tcg_out_op_i32_const(s, ws->helpers[func_idx].func_id);
+    tcg_out8(s, 0x11); /* call_indirect */
+    tcg_out_leb128_uint32_t(s, func_idx + 1);
+    tcg_out8(s, 0x00); /* table 0 */
+}
