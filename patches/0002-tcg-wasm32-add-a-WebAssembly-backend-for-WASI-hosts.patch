+static void tcg_out_leb128_sint32_t(TCGContext *s, int32_t v) {
+    bool more = true;
+    bool negative = (v < 0);
+    uint8_t b;
+    uint32_t low7 = 0x7f;
+    uint32_t uv = v;
+    while (more) {
+        b = uv & low7;
+        uv >>= 7;
+        if (negative)
+            uv |= (~0 << (32 - 7));
+        if (((uv == 0) && ((b & 0x40) == 0)) || ((uv == -1) && ((b & 0x40) != 0)))
+            more = false;
+        else
+            b |= 0x80;
+        tcg_out8(s, b);
+    }
+}
+
+static void tcg_out_leb128_sint64_t(TCGContext *s, int64_t v) {
+    bool more = true;
+    bool negative = (v < 0);
+    uint8_t b;
+    uint64_t low7 = 0x7f;
+    uint64_t uv = v;
+    while (more) {
+        b = uv & low7;
+        uv >>= 7;
+        if (negative)
+            uv |= ((int64_t)(~0) << (64 - 7));
+        if (((uv == 0) && ((b & 0x40) == 0)) || (((int64_t)uv == -1) && ((b & 0x40) != 0)))
+            more = false;
+        else
+            b |= 0x80;
+        tcg_out8(s, b);
+    }
+}
+
+static void tcg_out_leb128_uint32_t(TCGContext *s, uint32_t v) {
+    uint32_t low7 = 0x7f;
+    uint8_t b;
+    do {
+        b = v & low7;
+        v >>= 7;
+        if (v != 0)
+            b |= 0x80;
+        tcg_out8(s, b);
+    } while (v != 0);
+}
