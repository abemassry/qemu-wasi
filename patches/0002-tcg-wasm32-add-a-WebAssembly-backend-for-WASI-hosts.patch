+    case 1509: return ((L (*)(I, I, I, L, I, L, L, L))(uintptr_t)fn)((I)a[0], (I)a[1], (I)a[2], (L)a[3], (I)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1510: return ((L (*)(L, I, I, L, I, L, L, L))(uintptr_t)fn)((L)a[0], (I)a[1], (I)a[2], (L)a[3], (I)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1511: return ((L (*)(I, L, I, L, I, L, L, L))(uintptr_t)fn)((I)a[0], (L)a[1], (I)a[2], (L)a[3], (I)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1512: return ((L (*)(L, L, I, L, I, L, L, L))(uintptr_t)fn)((L)a[0], (L)a[1], (I)a[2], (L)a[3], (I)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1513: return ((L (*)(I, I, L, L, I, L, L, L))(uintptr_t)fn)((I)a[0], (I)a[1], (L)a[2], (L)a[3], (I)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1514: return ((L (*)(L, I, L, L, I, L, L, L))(uintptr_t)fn)((L)a[0], (I)a[1], (L)a[2], (L)a[3], (I)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1515: return ((L (*)(I, L, L, L, I, L, L, L))(uintptr_t)fn)((I)a[0], (L)a[1], (L)a[2], (L)a[3], (I)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1516: return ((L (*)(L, L, L, L, I, L, L, L))(uintptr_t)fn)((L)a[0], (L)a[1], (L)a[2], (L)a[3], (I)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1517: return ((L (*)(I, I, I, I, L, L, L, L))(uintptr_t)fn)((I)a[0], (I)a[1], (I)a[2], (I)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1518: return ((L (*)(L, I, I, I, L, L, L, L))(uintptr_t)fn)((L)a[0], (I)a[1], (I)a[2], (I)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1519: return ((L (*)(I, L, I, I, L, L, L, L))(uintptr_t)fn)((I)a[0], (L)a[1], (I)a[2], (I)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1520: return ((L (*)(L, L, I, I, L, L, L, L))(uintptr_t)fn)((L)a[0], (L)a[1], (I)a[2], (I)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1521: return ((L (*)(I, I, L, I, L, L, L, L))(uintptr_t)fn)((I)a[0], (I)a[1], (L)a[2], (I)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1522: return ((L (*)(L, I, L, I, L, L, L, L))(uintptr_t)fn)((L)a[0], (I)a[1], (L)a[2], (I)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1523: return ((L (*)(I, L, L, I, L, L, L, L))(uintptr_t)fn)((I)a[0], (L)a[1], (L)a[2], (I)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1524: return ((L (*)(L, L, L, I, L, L, L, L))(uintptr_t)fn)((L)a[0], (L)a[1], (L)a[2], (I)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1525: return ((L (*)(I, I, I, L, L, L, L, L))(uintptr_t)fn)((I)a[0], (I)a[1], (I)a[2], (L)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1526: return ((L (*)(L, I, I, L, L, L, L, L))(uintptr_t)fn)((L)a[0], (I)a[1], (I)a[2], (L)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1527: return ((L (*)(I, L, I, L, L, L, L, L))(uintptr_t)fn)((I)a[0], (L)a[1], (I)a[2], (L)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1528: return ((L (*)(L, L, I, L, L, L, L, L))(uintptr_t)fn)((L)a[0], (L)a[1], (I)a[2], (L)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1529: return ((L (*)(I, I, L, L, L, L, L, L))(uintptr_t)fn)((I)a[0], (I)a[1], (L)a[2], (L)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1530: return ((L (*)(L, I, L, L, L, L, L, L))(uintptr_t)fn)((L)a[0], (I)a[1], (L)a[2], (L)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1531: return ((L (*)(I, L, L, L, L, L, L, L))(uintptr_t)fn)((I)a[0], (L)a[1], (L)a[2], (L)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    case 1532: return ((L (*)(L, L, L, L, L, L, L, L))(uintptr_t)fn)((L)a[0], (L)a[1], (L)a[2], (L)a[3], (L)a[4], (L)a[5], (L)a[6], (L)a[7]);
+    default:
+        g_assert_not_reached();
+    }
+}
diff --git a/tcg/wasm32/wasi-interp.c.inc b/tcg/wasm32/wasi-interp.c.inc
new file mode 100644
index 0000000..27fdbb6
--- /dev/null
+++ b/tcg/wasm32/wasi-interp.c.inc
@@ -0,0 +1,1311 @@
+/*
+ * Interpreter tier for wasm32 TCG translation blocks (WASI).
+ *
+ * Compiling a TB's wasm module with the host JIT (Cranelift) costs about
+ * 1 ms, roughly a thousand times the cost of executing the TB once, and most
+ * TBs only ever run a few times.  So every TB starts out interpreted here,
+ * and is handed to the JIT only once it has executed QEMU_JIT_HOT times
+ * (default INTERP_HOT_DEFAULT).
+ *
+ * The interpreter runs exactly the wasm function the JIT would compile: the
+ * TB's prologue followed by its body (see wasm_finalize_module).  A one-time
+ * decoding pass converts it to a compact internal form: LEB128 immediates
+ * become fixed-size fields, block/loop/end disappear, and every branch
+ * carries its resolved target.  The pass also validates operand stack
+ * heights, so the executor needs no control stack.  It accepts only the
+ * subset of wasm that the backend emits; any TB using something else falls
+ * back to the JIT.
+ *
+ * Values are kept on the operand stack as uint64_t, with i32 values
+ * zero-extended.  Linear memory is QEMU's own, so loads and stores are plain
+ * pointer accesses, and helpers are called through typed C function
+ * pointers (wasi-interp-calls.c.inc).  An exception thrown by a helper
+ * (siglongjmp from cpu_loop_exit) simply unwinds through interp_exec().
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/bitops.h"
+#include "qemu/host-utils.h"
+#include "wasi-interp-calls.c.inc"
+
+/*
+ * Interpreted runs before a TB is compiled.  Compiling costs about 1.5 ms
+ * and saves about 0.7 us per later run, so it pays off only for TBs that
+ * will run a few thousand more times; booting Alpine to a login prompt was
+ * ~10% faster with 5000 than with 1000.
+ */
+#define INTERP_HOT_DEFAULT  5000
+/*
+ * Interpreted runs after which a TB whose identical module the host compiled
+ * before (e.g. ahead of the last TB buffer flush, which discards all
+ * translations) goes straight back to the JIT: loading a cached module costs
+ * about 50 us, against 2.5 ms of slower interpreted runs up to
+ * INTERP_HOT_DEFAULT.  QEMU_JIT_WARM overrides it.
+ */
+#define INTERP_WARM_DEFAULT 50
+#define INTERP_STACK_MAX    64
+/*
+ * The context parameter and the locals wasm_finalize_module declares: two
+ * i32 temporaries, five i64 ones and the register file (REG_LOCAL_BASE).
+ * TBs use no globals.
+ */
+#define INTERP_LOCALS_MAX   (1 + 2 + 5 + 25)
+#define INTERP_CTL_MAX      64
+#define INTERP_TYPES_MAX    1024
+
+/*
+ * A TB's program slot holds 0 (not decoded yet), INTERP_UNSUPPORTED, or a
+ * decoded program (8-byte aligned), possibly tagged with INTERP_NO_JIT:
+ * the TB's wasm is not valid, or the JIT rejected it, so it must stay
+ * interpreted however hot it gets.
+ */
+#define INTERP_UNSUPPORTED  ((uintptr_t)1)
+#define INTERP_NO_JIT       ((uintptr_t)2)
+#define INTERP_PROG(slot)   ((const uint8_t *)((slot) & ~(uintptr_t)7))
+
+/*
+ * Internal control opcodes.  Everything else keeps its wasm opcode, with
+ * fixed-size immediates: local/global index u8, load/store offset u32,
+ * i32.const u32, i64.const u64.
+ */
+enum {
+    I_TRAP   = 0x00,    /* unreachable */
+    I_IFZ    = 0x04,    /* [u32 target] pop i32, branch if zero */
+    I_JMP    = 0x0c,    /* [u32 target] */
+    I_BRNZ   = 0x0d,    /* [u32 target] pop i32, branch if non-zero */
+    I_RETURN = 0x0f,    /* return the i32 on top of the stack */
+    I_CALL   = 0x11,    /* [u16 sig][u8 nparams][u8 nresults] */
+};
+
+/* Branch target fields are offsets from the start of the program. */
+typedef uint32_t interp_target;
+
+static unsigned interp_hot = INTERP_HOT_DEFAULT;
+static unsigned interp_warm = INTERP_WARM_DEFAULT;
+
+static struct {
+    uint64_t execs;         /* TB executions by the interpreter */
+    uint64_t decoded;       /* TBs decoded */
+    uint64_t unsupported;   /* TBs the interpreter rejected */
+    uint64_t promoted;      /* TBs handed to the JIT after getting hot */
+    uint64_t reloaded;      /* TBs put back on the JIT from the host's cache */
+    uint64_t decoded_bytes; /* size of all decoded programs */
+    uint64_t invalid;       /* TBs whose wasm failed type checking */
+    uint64_t jit_failed;    /* TBs the JIT could not compile */
+} interp_stats;
+
+/* ---------------------------------------------------------------------- */
+/* Arena for decoded programs                                             */
+/* ---------------------------------------------------------------------- */
+
+typedef struct InterpChunk {
+    struct InterpChunk *next;
+    size_t used, size;
+    uint64_t data[];        /* 8-byte aligned: slot tags use the low bits */
+} InterpChunk;
+
+static InterpChunk *interp_chunks;      /* current generation */
+static InterpChunk *interp_retired;     /* waiting to be freed */
+
+static void *interp_alloc(size_t n)
+{
+    InterpChunk *c = interp_chunks;
+    void *p;
+
+    n = ROUND_UP(n, 8);
+    if (!c || c->size - c->used < n) {
+        size_t size = MAX(n, 1 << 20);
+
+        c = g_malloc(sizeof(*c) + size);
+        c->next = interp_chunks;
+        c->used = 0;
+        c->size = size;
+        interp_chunks = c;
+    }
+    p = (uint8_t *)c->data + c->used;
+    c->used += n;
+    return p;
+}
+
+/*
+ * The TB code buffer was flushed, so every decoded program is obsolete.
+ * The flush can happen inside a helper called from a TB that is being
+ * interpreted right now, so the memory is only retired here and freed by
+ * interp_free_retired() once no TB is running.
+ */
+static void interp_arena_retire(void)
+{
+    while (interp_chunks) {
+        InterpChunk *c = interp_chunks;
+
+        interp_chunks = c->next;
+        c->next = interp_retired;
+        interp_retired = c;
+    }
+}
+
+static void interp_free_retired(void)
+{
+    while (interp_retired) {
+        InterpChunk *c = interp_retired;
+
+        interp_retired = c->next;
+        g_free(c);
+    }
+}
+
+/* ---------------------------------------------------------------------- */
+/* Decoder                                                                */
+/* ---------------------------------------------------------------------- */
+
+typedef struct {
+    const uint8_t *p, *end;
+    bool ok;
+} InterpReader;
+
+static uint8_t rd_u8(InterpReader *r)
+{
+    if (r->p >= r->end) {
+        r->ok = false;
+        return 0;
+    }
+    return *r->p++;
+}
+
+static uint32_t rd_uleb32(InterpReader *r)
+{
+    uint32_t v = 0;
+    int shift = 0;
+    uint8_t b;
+
+    do {
+        b = rd_u8(r);
+        if (shift < 32) {
+            v |= (uint32_t)(b & 0x7f) << shift;
+        }
+        shift += 7;
+    } while ((b & 0x80) && r->ok && shift < 35);
+    if (b & 0x80) {
+        r->ok = false;
+    }
+    return v;
+}
+
+static uint64_t rd_sleb(InterpReader *r, int bits)
+{
+    uint64_t v = 0;
+    int shift = 0;
+    uint8_t b;
+
+    do {
+        b = rd_u8(r);
+        if (shift < 64) {
+            v |= (uint64_t)(b & 0x7f) << shift;
+        }
+        shift += 7;
+    } while ((b & 0x80) && r->ok && shift < 70);
+    if (b & 0x80) {
+        r->ok = false;
+    }
+    if (shift < 64 && (b & 0x40)) {
+        v |= ~UINT64_C(0) << shift;
+    }
+    return bits == 32 ? (uint64_t)(uint32_t)v : v;
+}
+
+enum { T_ANY = 0, T_I64 = 0x7e, T_I32 = 0x7f };
+
+typedef struct {
+    uint16_t sig;           /* INTERP_SIG() value, 0xffff if unusable */
+    uint8_t nparams, nresults;
+    uint8_t i64_params;     /* bit i set: parameter i is i64 */
+    uint8_t result;         /* T_I32 / T_I64 when nresults == 1 */
+} InterpType;
+
+enum { CTL_FUNC, CTL_BLOCK, CTL_LOOP, CTL_IF };
+
+typedef struct {
+    uint8_t kind;
+    uint8_t arity;          /* number of results: 0 or 1 */
+    uint8_t rtype;          /* result type when arity == 1 */
+    uint32_t height;        /* operand stack height on entry */
+    uint32_t start;         /* CTL_LOOP: offset of the loop body */
+    int32_t fixups;         /* chain of branch targets to patch at end */
+    int32_t if_target;      /* CTL_IF: offset of the I_IFZ target, -1 when patched */
+} InterpCtl;
+
+typedef struct {
+    InterpReader in;
+    uint8_t *out, *out_end;
+    uint32_t pos;           /* bytes written to out */
+    uint32_t ntypes;
+    uint32_t nlocals;       /* parameter + declared locals */
+    int nctl;
+    uint32_t height, max_height;
+    const char *why;        /* reason for rejecting the TB */
+    int bad_op;
+    const char *type_err;   /* first wasm validation error, if any */
+    int type_err_op;
+    uint32_t type_err_at;   /* offset in the function body */
+    const uint8_t *body;    /* start of the function body */
+    uint8_t vt[INTERP_STACK_MAX];           /* operand types */
+    uint8_t local_t[INTERP_LOCALS_MAX];     /* local types */
+    /* Large tables last: everything above is reset for each TB. */
+    InterpType types[INTERP_TYPES_MAX];
+    InterpCtl ctl[INTERP_CTL_MAX];
+} InterpDecoder;
+
+static bool dec_fail(InterpDecoder *d, const char *why, int op)
+{
+    if (!d->why) {
+        d->why = why;
+        d->bad_op = op;
+    }
+    return false;
+}
+
+static void emit_u8(InterpDecoder *d, uint8_t v)
+{
+    if (d->out + d->pos < d->out_end) {
+        d->out[d->pos] = v;
+    }
+    d->pos++;
+}
+
+static void emit_bytes(InterpDecoder *d, const void *v, size_t n)
+{
+    for (size_t i = 0; i < n; i++) {
+        emit_u8(d, ((const uint8_t *)v)[i]);
+    }
+}
+
+static void emit_u16(InterpDecoder *d, uint16_t v) { emit_bytes(d, &v, 2); }
+static void emit_u32(InterpDecoder *d, uint32_t v) { emit_bytes(d, &v, 4); }
+static void emit_u64(InterpDecoder *d, uint64_t v) { emit_bytes(d, &v, 8); }
+
+static void patch_u32(InterpDecoder *d, uint32_t at, uint32_t v)
+{
+    if (d->out + at + 4 <= d->out_end) {
+        memcpy(d->out + at, &v, 4);
+    }
+}
+
+/*
+ * Forward branch targets are chained through their own (not yet used)
+ * target fields: each holds the offset of the previous one, or -1.
+ */
+static void add_fixup(InterpDecoder *d, InterpCtl *c, uint32_t at)
+{
+    patch_u32(d, at, (uint32_t)c->fixups);
+    c->fixups = (int32_t)at;
+}
+
+static void resolve_fixups(InterpDecoder *d, InterpCtl *c, uint32_t target)
+{
+    int32_t at = c->fixups;
+
+    while (at >= 0) {
+        uint32_t next;
+
+        memcpy(&next, d->out + at, 4);
+        patch_u32(d, at, target);
+        at = (int32_t)next;
+    }
+    c->fixups = -1;
+}
+
+static bool pop_n(InterpDecoder *d, uint32_t n)
+{
+    if (d->height < d->ctl[d->nctl - 1].height + n) {
+        return dec_fail(d, "operand stack underflow", -1);
+    }
+    d->height -= n;
+    return true;
+}
+
+static bool push_n(InterpDecoder *d, uint32_t n)
+{
+    d->height += n;
+    d->max_height = MAX(d->max_height, d->height);
+    if (d->max_height > INTERP_STACK_MAX - 2) {
+        return dec_fail(d, "operand stack too deep", -1);
+    }
+    return true;
+}
+
+/*
+ * Record a wasm validation error.  Decoding carries on: the program is
+ * still well defined for the interpreter, but the JIT would reject it.
+ */
+static void type_error(InterpDecoder *d, const char *what, int op)
+{
+    if (!d->type_err) {
+        d->type_err = what;
+        d->type_err_op = op;
+        d->type_err_at = (uint32_t)(d->in.p - d->body);
+    }
+}
+
+static bool push_t(InterpDecoder *d, uint8_t t)
+{
+    if (!push_n(d, 1)) {
+        return false;
+    }
+    d->vt[d->height - 1] = t;
+    return true;
+}
+
+/* Pop one operand, checking its type unless t is T_ANY. */
+static bool pop_t(InterpDecoder *d, uint8_t t, int op)
+{
+    if (!pop_n(d, 1)) {
+        return false;
+    }
+    if (t != T_ANY && d->vt[d->height] != t) {
+        type_error(d, "operand has the wrong type", op);
+    }
+    return true;
+}
+
+static uint8_t top_t(InterpDecoder *d)
+{
+    return d->height ? d->vt[d->height - 1] : T_ANY;
+}
+
+/* Parse a block type; only "no result", i32 and i64 are accepted. */
+static bool rd_blocktype(InterpDecoder *d, uint8_t *arity, uint8_t *rtype)
+{
+    uint8_t bt = rd_u8(&d->in);
+
+    switch (bt) {
+    case 0x40:
+        *arity = 0;
+        *rtype = T_ANY;
+        return true;
+    case 0x7f:
+    case 0x7e:
+        *arity = 1;
+        *rtype = bt;
+        return true;
+    default:
+        return dec_fail(d, "unsupported block type", bt);
+    }
+}
+
+static bool push_ctl(InterpDecoder *d, uint8_t kind, uint8_t arity,
+                     uint8_t rtype)
+{
+    InterpCtl *c;
+
+    if (d->nctl == INTERP_CTL_MAX) {
+        return dec_fail(d, "blocks nested too deeply", -1);
+    }
+    c = &d->ctl[d->nctl++];
+    c->kind = kind;
+    c->arity = arity;
+    c->rtype = rtype;
+    c->height = d->height;
+    c->start = d->pos;
+    c->fixups = -1;
+    c->if_target = -1;
+    return true;
+}
+
+/* Emit a branch to the label at relative depth "depth". */
+static bool emit_branch(InterpDecoder *d, uint8_t op, uint32_t depth)
+{
+    InterpCtl *c;
+
+    if (depth >= (uint32_t)d->nctl - 1) {
+        /* A branch out of the function body: not produced by the backend. */
+        return dec_fail(d, "branch to function level", op);
+    }
+    c = &d->ctl[d->nctl - 1 - depth];
+    /*
+     * The executor jumps without adjusting the operand stack, so the stack
+     * must already have exactly the height the target expects, and no
+     * values may be carried along.
+     */
+    if (c->kind == CTL_LOOP ? false : c->arity != 0) {
+        return dec_fail(d, "branch carrying a value", op);
+    }
+    if (d->height != c->height) {
+        return dec_fail(d, "branch with values left on the stack", op);
+    }
+    emit_u8(d, op);
+    if (c->kind == CTL_LOOP) {
+        emit_u32(d, c->start);
+    } else {
+        uint32_t at = d->pos;
+
+        emit_u32(d, 0);
+        add_fixup(d, c, at);
+    }
+    return true;
+}
+
+/*
+ * Skip the immediates of a non-control instruction in unreachable code.
+ * Returns false for opcodes the interpreter does not support at all.
+ */
+static bool skip_immediates(InterpDecoder *d, uint8_t op)
+{
+    switch (op) {
+    case 0x0c: case 0x0d:                       /* br, br_if */
+    case 0x20: case 0x21: case 0x22:            /* local.* */
+        rd_uleb32(&d->in);
+        return true;
+    case 0x11:                                  /* call_indirect */
+        rd_uleb32(&d->in);
+        rd_u8(&d->in);
+        return true;
+    case 0x28 ... 0x3e:                         /* loads and stores */
+        rd_uleb32(&d->in);
+        rd_uleb32(&d->in);
+        return true;
+    case 0x41:
+        rd_sleb(&d->in, 32);
+        return true;
+    case 0x42:
+        rd_sleb(&d->in, 64);
+        return true;
+    case 0x00: case 0x01: case 0x0f: case 0x1a: case 0x1b:
+    case 0x45 ... 0x5a:
+    case 0x67 ... 0x78:
+    case 0x79 ... 0x8a:
+    case 0xa7: case 0xac: case 0xad:
+    case 0xc0 ... 0xc4:
+        return true;
+    default:
+        return dec_fail(d, "unsupported opcode", op);
+    }
+}
+
+/* Operand and result types of numeric opcodes. */
+static void numeric_types(uint8_t op, uint8_t *in, uint8_t *out)
+{
+    if (op == 0x45 || (op >= 0x46 && op <= 0x4f)) {
+        *in = T_I32; *out = T_I32;          /* i32 tests and comparisons */
+    } else if (op >= 0x50 && op <= 0x5a) {
+        *in = T_I64; *out = T_I32;          /* i64 tests and comparisons */
+    } else if (op >= 0x67 && op <= 0x78) {
+        *in = T_I32; *out = T_I32;
+    } else if (op >= 0x79 && op <= 0x8a) {
+        *in = T_I64; *out = T_I64;
+    } else if (op == 0xa7) {
+        *in = T_I64; *out = T_I32;          /* i32.wrap_i64 */
+    } else if (op == 0xac || op == 0xad) {
+        *in = T_I32; *out = T_I64;          /* i64.extend_i32 */
+    } else if (op == 0xc0 || op == 0xc1) {
+        *in = T_I32; *out = T_I32;
+    } else {
+        *in = T_I64; *out = T_I64;          /* i64.extendN_s */
+    }
+}
+
+/* Unary numeric opcodes (pop 1, push 1); other numeric ones are binary. */
+static bool is_unary(uint8_t op)
+{
+    switch (op) {
+    case 0x45: case 0x50:                       /* eqz */
+    case 0x67: case 0x68: case 0x69:            /* i32 clz/ctz/popcnt */
+    case 0x79: case 0x7a: case 0x7b:            /* i64 clz/ctz/popcnt */
+    case 0xa7: case 0xac: case 0xad:            /* wrap, extend_i32 */
+    case 0xc0 ... 0xc4:                         /* extendN_s */
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool decode_body(InterpDecoder *d)
+{
+    /* Inside dead code: number of control entries when it started, or -1. */
+    int dead_at = -1;
+
+    if (!push_ctl(d, CTL_FUNC, 1, T_I32)) {
+        return false;
+    }
+
+    while (d->in.ok && d->nctl > 0) {
+        uint8_t op = rd_u8(&d->in);
+
+        if (!d->in.ok) {
+            break;
+        }
+
+        if (dead_at >= 0) {
+            /*
+             * Unreachable code after br/return/unreachable: track the block
+             * structure until the enclosing block ends, emit nothing.
+             */
+            switch (op) {
+            case 0x02: case 0x03: case 0x04: {
+                uint8_t arity, rtype;
+
+                if (!rd_blocktype(d, &arity, &rtype) ||
+                    !push_ctl(d, CTL_BLOCK, arity, rtype)) {
+                    return false;
+                }
+                continue;
+            }
+            case 0x05:
+            case 0x0b:
+                if (d->nctl > dead_at) {
+                    if (op == 0x0b) {
+                        d->nctl--;
+                    }
+                    continue;
+                }
+                /* Back at the block that contained the dead code. */
+                dead_at = -1;
+                d->height = d->ctl[d->nctl - 1].height +
+                    (op == 0x0b ? d->ctl[d->nctl - 1].arity : 0);
+                if (op == 0x0b && d->ctl[d->nctl - 1].arity) {
+                    d->vt[d->height - 1] = d->ctl[d->nctl - 1].rtype;
+                }
+                if (op == 0x05) {
+                    InterpCtl *c = &d->ctl[d->nctl - 1];
+
+                    /* The "then" arm ended in a branch: no jump over "else". */
+                    if (c->kind != CTL_IF || c->if_target < 0) {
+                        return dec_fail(d, "misplaced else", op);
+                    }
+                    patch_u32(d, c->if_target, d->pos);
+                    c->if_target = -1;
+                    d->height = c->height;
+                    continue;
+                }
+                goto do_end;
+            default:
+                if (!skip_immediates(d, op)) {
+                    return false;
+                }
+                continue;
+            }
+        }
+
+        switch (op) {
+        case 0x00:                              /* unreachable */
+            emit_u8(d, I_TRAP);
+            dead_at = d->nctl;
+            break;
+        case 0x01:                              /* nop */
+            break;
+        case 0x02: {                            /* block */
+            uint8_t arity, rtype;
+
+            if (!rd_blocktype(d, &arity, &rtype) ||
+                !push_ctl(d, CTL_BLOCK, arity, rtype)) {
+                return false;
+            }
+            break;
+        }
+        case 0x03: {                            /* loop */
+            uint8_t arity, rtype;
+
+            if (!rd_blocktype(d, &arity, &rtype)) {
+                return false;
+            }
+            if (arity) {
+                return dec_fail(d, "loop with a result", op);
+            }
+            if (!push_ctl(d, CTL_LOOP, 0, T_ANY)) {
+                return false;
+            }
+            break;
+        }
+        case 0x04: {                            /* if */
+            uint8_t arity, rtype;
+            uint32_t at;
+
+            if (!rd_blocktype(d, &arity, &rtype) || !pop_t(d, T_I32, op)) {
+                return false;
+            }
+            emit_u8(d, I_IFZ);
+            at = d->pos;
+            emit_u32(d, 0);
+            if (!push_ctl(d, CTL_IF, arity, rtype)) {
+                return false;
+            }
+            d->ctl[d->nctl - 1].if_target = (int32_t)at;
+            break;
+        }
+        case 0x05: {                            /* else */
+            InterpCtl *c = &d->ctl[d->nctl - 1];
+            uint32_t at;
+
+            if (c->kind != CTL_IF || c->if_target < 0) {
+                return dec_fail(d, "misplaced else", op);
+            }
+            if (d->height != c->height + c->arity) {
+                return dec_fail(d, "bad stack height at else", op);
+            }
+            if (c->arity && top_t(d) != c->rtype) {
+                type_error(d, "if arm has the wrong result type", op);
+            }
+            /* The "then" arm jumps over the "else" arm. */
+            emit_u8(d, I_JMP);
+            at = d->pos;
+            emit_u32(d, 0);
+            add_fixup(d, c, at);
+            patch_u32(d, c->if_target, d->pos);
+            c->if_target = -1;
+            d->height = c->height;
+            break;
+        }
+        case 0x0b: {                            /* end */
+            InterpCtl *c = &d->ctl[d->nctl - 1];
+
+            if (d->height != c->height + c->arity) {
+                return dec_fail(d, "bad stack height at end", op);
+            }
+            if (c->arity && top_t(d) != c->rtype) {
+                type_error(d, "block has the wrong result type", op);
+            }
+        do_end:
+            c = &d->ctl[d->nctl - 1];
+            if (c->kind == CTL_FUNC) {
+                if (dead_at < 0) {
+                    emit_u8(d, I_RETURN);
+                }
+                d->nctl--;
+                break;
+            }
+            if (c->kind == CTL_IF && c->if_target >= 0) {
+                if (c->arity) {
+                    return dec_fail(d, "if with a result but no else", op);
+                }
+                patch_u32(d, c->if_target, d->pos);
+            }
+            resolve_fixups(d, c, d->pos);
+            d->height = c->height + c->arity;
+            d->nctl--;
+            break;
+        }
+        case 0x0c:                              /* br */
+            if (!emit_branch(d, I_JMP, rd_uleb32(&d->in))) {
+                return false;
+            }
+            dead_at = d->nctl;
+            break;
+        case 0x0d: {                            /* br_if */
+            uint32_t depth = rd_uleb32(&d->in);
+
+            if (!pop_t(d, T_I32, op) || !emit_branch(d, I_BRNZ, depth)) {
+                return false;
+            }
+            break;
+        }
+        case 0x0f:                              /* return */
+            if (d->height < 1) {
+                return dec_fail(d, "return without a value", op);
+            }
+            if (top_t(d) != T_I32) {
+                type_error(d, "return value is not i32", op);
+            }
+            emit_u8(d, I_RETURN);
+            dead_at = d->nctl;
+            break;
+        case 0x11: {                            /* call_indirect */
+            uint32_t t = rd_uleb32(&d->in);
+            InterpType *ty;
+
+            if (rd_u8(&d->in) != 0 || t >= d->ntypes) {
+                return dec_fail(d, "bad call_indirect", op);
+            }
+            ty = &d->types[t];
+            if (ty->sig == 0xffff) {
+                return dec_fail(d, "unsupported helper signature", op);
+            }
+            if (!pop_t(d, T_I32, op)) {         /* table index */
+                return false;
+            }
+            for (int i = ty->nparams - 1; i >= 0; i--) {
+                if (!pop_t(d, (ty->i64_params >> i) & 1 ? T_I64 : T_I32, op)) {
+                    return false;
+                }
+            }
+            if (ty->nresults && !push_t(d, ty->result)) {
+                return false;
+            }
+            emit_u8(d, I_CALL);
+            emit_u16(d, ty->sig);
+            emit_u8(d, ty->nparams);
+            emit_u8(d, ty->nresults);
+            break;
+        }
+        case 0x1a:                              /* drop */
+            if (!pop_t(d, T_ANY, op)) {
+                return false;
+            }
+            emit_u8(d, op);
+            break;
+        case 0x1b: {                            /* select */
+            uint8_t t;
+
+            if (!pop_t(d, T_I32, op) || !pop_n(d, 1)) {
+                return false;
+            }
+            t = d->vt[d->height];
+            if (d->height < d->ctl[d->nctl - 1].height + 1) {
+                return dec_fail(d, "operand stack underflow", op);
+            }
+            if (top_t(d) != t) {
+                type_error(d, "select operands differ in type", op);
+            }
+            emit_u8(d, op);
+            break;
+        }
+        case 0x20: case 0x21: case 0x22: {      /* local.get/set/tee */
+            uint32_t i = rd_uleb32(&d->in);
+
+            if (i >= d->nlocals) {
+                return dec_fail(d, "bad local index", op);
+            }
+            if (op == 0x20) {
+                if (!push_t(d, d->local_t[i])) {
+                    return false;
+                }
+            } else if (op == 0x21) {
+                if (!pop_t(d, d->local_t[i], op)) {
+                    return false;
+                }
+            } else if (top_t(d) != d->local_t[i]) {
+                type_error(d, "local.tee of the wrong type", op);
+            }
+            emit_u8(d, op);
+            emit_u8(d, i);
+            break;
+        }
+        case 0x28: case 0x29:                   /* i32/i64.load */
+        case 0x2c ... 0x35:                     /* narrow loads */
+        case 0x36: case 0x37:                   /* i32/i64.store */
+        case 0x3a ... 0x3e: {                   /* narrow stores */
+            uint32_t offset;
+
+            rd_uleb32(&d->in);                  /* alignment hint */
+            offset = rd_uleb32(&d->in);
+            if (op >= 0x36) {                   /* store: value, address */
+                bool v64 = op == 0x37 || op >= 0x3c;
+
+                if (!pop_t(d, v64 ? T_I64 : T_I32, op) || !pop_t(d, T_I32, op)) {
+                    return false;
+                }
+            } else {                            /* load: address -> value */
+                bool v64 = op == 0x29 || op >= 0x30;
+
+                if (!pop_t(d, T_I32, op) || !push_t(d, v64 ? T_I64 : T_I32)) {
+                    return false;
+                }
+            }
+            emit_u8(d, op);
+            emit_u32(d, offset);
+            break;
+        }
+        case 0x41:                              /* i32.const */
+            if (!push_t(d, T_I32)) {
+                return false;
+            }
+            emit_u8(d, op);
+            emit_u32(d, (uint32_t)rd_sleb(&d->in, 32));
+            break;
+        case 0x42:                              /* i64.const */
+            if (!push_t(d, T_I64)) {
+                return false;
+            }
+            emit_u8(d, op);
+            emit_u64(d, rd_sleb(&d->in, 64));
+            break;
+        case 0x45 ... 0x5a:                     /* comparisons */
+        case 0x67 ... 0x8a:                     /* integer arithmetic */
+        case 0xa7: case 0xac: case 0xad:        /* conversions */
+        case 0xc0 ... 0xc4:                     /* sign extensions */
+        {
+            uint8_t tin, tout;
+
+            numeric_types(op, &tin, &tout);
+            if (!is_unary(op) && !pop_t(d, tin, op)) {
+                return false;
+            }
+            if (!pop_t(d, tin, op) || !push_t(d, tout)) {
+                return false;
+            }
+            emit_u8(d, op);
+            break;
+        }
+        default:
+            return dec_fail(d, "unsupported opcode", op);
+        }
+    }
+
+    if (!d->in.ok || d->nctl != 0 || d->in.p != d->in.end) {
+        return dec_fail(d, "malformed function body", -1);
+    }
+    return true;
+}
+
+/* Parse the type section into interpreter call signatures. */
+static bool decode_types(InterpDecoder *d, InterpReader r)
+{
+    uint32_t n = rd_uleb32(&r);
+
+    if (n > INTERP_TYPES_MAX) {
+        return dec_fail(d, "too many types", -1);
+    }
+    for (uint32_t i = 0; i < n && r.ok; i++) {
+        InterpType *t = &d->types[i];
+        uint32_t np, nr, mask = 0, res = 0;
+        bool usable = true;
+
+        if (rd_u8(&r) != 0x60) {
+            return dec_fail(d, "bad type", -1);
+        }
+        np = rd_uleb32(&r);
+        for (uint32_t j = 0; j < np && r.ok; j++) {
+            uint8_t vt = rd_u8(&r);
+
+            if (vt == 0x7e && j < 32) {
+                mask |= 1u << j;
+            } else if (vt != 0x7f) {
+                usable = false;
+            }
+        }
+        nr = rd_uleb32(&r);
+        for (uint32_t j = 0; j < nr && r.ok; j++) {
+            uint8_t vt = rd_u8(&r);
+
+            res = vt == 0x7f ? 1 : vt == 0x7e ? 2 : (usable = false, 0);
+        }
+        if (np > INTERP_MAX_PARAMS || nr > 1) {
+            usable = false;
+        }
+        t->sig = usable ? INTERP_SIG(res, np, mask) : 0xffff;
+        t->nparams = np;
+        t->nresults = nr;
+        t->i64_params = mask;
+        t->result = res == 2 ? T_I64 : T_I32;
+    }
+    d->ntypes = n;
+    return r.ok || dec_fail(d, "truncated type section", -1);
+}
+
+/*
+ * Decode the TB at tb_ptr (layout: see compile_and_cache_tb) into an
+ * interpreter program.  Returns the program, or INTERP_UNSUPPORTED.
+ */
+static uintptr_t interp_decode(void *tb_ptr)
+{
+    static InterpDecoder *d;
+    static uint8_t *body, *out;
+    static size_t body_cap, out_cap;
+    uint8_t *base = tb_ptr;
+    uint32_t code_size = *(uint32_t *)(base + 4);
+    uint8_t *code_begin = base + 8;
+    uint32_t header_size = *(uint32_t *)(code_begin + code_size);
+    uint8_t *hdr = code_begin + code_size + 4;
+    InterpReader r = { hdr + 8, hdr + header_size, true };
+    const uint8_t *body_in_hdr = NULL;
+    uint32_t body_size = 0, groups;
+    size_t hdr_part;
+    void *prog;
+
+    if (!d) {
+        d = g_new0(InterpDecoder, 1);
+    }
+    memset(d, 0, offsetof(InterpDecoder, types));
+
+    /* Walk the sections up to the code section, which runs into the body. */
+    while (r.ok && r.p < r.end) {
+        uint8_t id = rd_u8(&r);
+        uint32_t size = rd_uleb32(&r);
+
+        if (id == 10) {
+            if (rd_uleb32(&r) != 1) {
+                dec_fail(d, "expected one function", -1);
+                goto fail;
+            }
+            body_size = rd_uleb32(&r);
+            body_in_hdr = r.p;
+            break;
+        }
+        if (size > (size_t)(r.end - r.p)) {
+            dec_fail(d, "truncated section", -1);
+            goto fail;
+        }
+        if (id == 1 && !decode_types(d, (InterpReader){ r.p, r.p + size, true })) {
+            goto fail;
+        }
+        r.p += size;
+    }
+    if (!r.ok || !body_in_hdr) {
+        dec_fail(d, "no code section", -1);
+        goto fail;
+    }
+
+    /* The body is the end of the header (locals + prologue) then the code. */
+    hdr_part = r.end - body_in_hdr;
+    if (hdr_part + code_size != body_size) {
+        dec_fail(d, "unexpected body size", -1);
+        goto fail;
+    }
+    if (body_cap < body_size) {
+        body_cap = body_size * 2;
+        body = g_realloc(body, body_cap);
+    }
+    memcpy(body, body_in_hdr, hdr_part);
+    memcpy(body + hdr_part, code_begin, code_size);
+
+    d->in = (InterpReader){ body, body + body_size, true };
+
+    /* Locals: parameter 0 is the context pointer. */
+    d->body = body;
+    d->nlocals = 1;
+    d->local_t[0] = T_I32;
+    groups = rd_uleb32(&d->in);
+    for (uint32_t i = 0; i < groups && d->in.ok; i++) {
+        uint32_t count = rd_uleb32(&d->in);
+        uint8_t vt = rd_u8(&d->in);
+
+        if ((vt != 0x7f && vt != 0x7e) ||
+            d->nlocals + count > INTERP_LOCALS_MAX) {
+            dec_fail(d, "unsupported locals", vt);
+            goto fail;
+        }
+        while (count--) {
+            d->local_t[d->nlocals++] = vt;
+        }
+    }
+
+    /* The decoded form is at most 5 times larger than the wasm. */
+    if (out_cap < (size_t)body_size * 5 + 64) {
+        out_cap = (size_t)body_size * 10 + 64;
+        out = g_realloc(out, out_cap);
+    }
+    d->out = out;
+    d->out_end = out + out_cap;
+    d->pos = 0;
+
+    if (!decode_body(d)) {
+        goto fail;
+    }
+    if (d->out + d->pos > d->out_end) {
+        dec_fail(d, "decoded program too large", -1);
+        goto fail;
+    }
+
+    prog = interp_alloc(d->pos);
+    memcpy(prog, out, d->pos);
+    interp_stats.decoded++;
+    interp_stats.decoded_bytes += d->pos;
+
+    if (d->type_err) {
+        /*
+         * Not valid wasm: a backend bug.  The interpreter does not care,
+         * but the JIT would reject the module, so never promote it.
+         */
+        static int reported;
+
+        interp_stats.invalid++;
+        if (reported < 20) {
+            reported++;
+            fprintf(stderr, "[wasi-interp] TB %p is not valid wasm: %s "
+                    "(opcode 0x%02x at body offset %u); it will stay "
+                    "interpreted\n", tb_ptr, d->type_err,
+                    d->type_err_op & 0xff, d->type_err_at);
+        }
+        return (uintptr_t)prog | INTERP_NO_JIT;
+    }
+    return (uintptr_t)prog;
+
+fail:
+    interp_stats.unsupported++;
+    {
+        static int reported;
+
+        if (reported < 20) {
+            reported++;
+            fprintf(stderr, "[wasi-interp] TB %p not interpretable: %s "
+                    "(opcode 0x%02x), using the JIT\n", tb_ptr,
+                    d->why ? d->why : "?", d->bad_op & 0xff);
+        }
+    }
+    return INTERP_UNSUPPORTED;
+}
+
+/* ---------------------------------------------------------------------- */
+/* Executor                                                               */
+/* ---------------------------------------------------------------------- */
+
+static G_NORETURN void interp_trap(const char *why)
+{
+    fprintf(stderr, "[wasi-interp] wasm trap: %s\n", why);
+    abort();
+}
+
+static inline uint32_t imm32(const uint8_t *p)
+{
+    uint32_t v;
+
+    memcpy(&v, p, 4);
+    return v;
+}
+
+static inline uint64_t imm64(const uint8_t *p)
+{
+    uint64_t v;
+
+    memcpy(&v, p, 8);
+    return v;
+}
+
+#define MEM(ea) ((void *)(uintptr_t)(uint32_t)(ea))
+
+static uint32_t interp_exec(const uint8_t *prog, struct wasmContext *c)
+{
+    uint64_t st[INTERP_STACK_MAX] __attribute__((uninitialized));
+    uint64_t loc[INTERP_LOCALS_MAX] = { (uint32_t)(uintptr_t)c };
+    uint64_t *sp = st;
+    const uint8_t *pc = prog;
+
+    for (;;) {
+        uint8_t op = *pc++;
+
+/* Binary operators: a = second from top, b = top. */
+#define BIN32(expr) do { uint32_t b = (uint32_t)*--sp, a = (uint32_t)sp[-1]; \
+                         sp[-1] = (uint32_t)(expr); } while (0)
+#define BIN64(expr) do { uint64_t b = *--sp, a = sp[-1]; \
+                         sp[-1] = (uint64_t)(expr); } while (0)
+#define UN32(expr)  do { uint32_t a = (uint32_t)sp[-1]; sp[-1] = (uint32_t)(expr); } while (0)
+#define UN64(expr)  do { uint64_t a = sp[-1]; sp[-1] = (uint64_t)(expr); } while (0)
+#define LOAD(type, conv) do { type v; memcpy(&v, MEM((uint32_t)sp[-1] + imm32(pc)), sizeof(v)); \
+                              pc += 4; sp[-1] = (conv); } while (0)
+#define STORE(type) do { type v = (type)*--sp; \
+                         memcpy(MEM((uint32_t)*--sp + imm32(pc)), &v, sizeof(v)); \
+                         pc += 4; } while (0)
+
+        switch (op) {
+        /* ---- control ---- */
+        case I_TRAP:
+            interp_trap("unreachable");
+        case I_IFZ:
+            pc = (uint32_t)*--sp ? pc + 4 : prog + imm32(pc);
+            break;
+        case I_JMP:
+            pc = prog + imm32(pc);
+            break;
+        case I_BRNZ:
+            pc = (uint32_t)*--sp ? prog + imm32(pc) : pc + 4;
+            break;
+        case I_RETURN:
+            return (uint32_t)sp[-1];
+        case I_CALL: {
+            uint16_t sig;
+            uint8_t np = pc[2], nr = pc[3];
+            uint32_t fn = (uint32_t)*--sp;
+            uint64_t r;
+
+            memcpy(&sig, pc, 2);
+            pc += 4;
+            sp -= np;
+            r = interp_call_helper(sig, fn, sp);
+            if (nr) {
+                *sp++ = r;
+            }
+            break;
+        }
+
+        /* ---- parametric and variables ---- */
+        case 0x1a:
+            sp--;
+            break;
+        case 0x1b: {
+            uint32_t cond = (uint32_t)*--sp;
+            uint64_t b = *--sp;
+
+            if (!cond) {
+                sp[-1] = b;
+            }
+            break;
+        }
+        case 0x20: *sp++ = loc[*pc++]; break;
+        case 0x21: loc[*pc++] = *--sp; break;
+        case 0x22: loc[*pc++] = sp[-1]; break;
+
+        /* ---- memory ---- */
+        case 0x28: LOAD(uint32_t, v); break;
+        case 0x29: LOAD(uint64_t, v); break;
+        case 0x2c: LOAD(int8_t, (uint32_t)(int32_t)v); break;
+        case 0x2d: LOAD(uint8_t, v); break;
+        case 0x2e: LOAD(int16_t, (uint32_t)(int32_t)v); break;
+        case 0x2f: LOAD(uint16_t, v); break;
+        case 0x30: LOAD(int8_t, (uint64_t)(int64_t)v); break;
+        case 0x31: LOAD(uint8_t, v); break;
+        case 0x32: LOAD(int16_t, (uint64_t)(int64_t)v); break;
+        case 0x33: LOAD(uint16_t, v); break;
+        case 0x34: LOAD(int32_t, (uint64_t)(int64_t)v); break;
+        case 0x35: LOAD(uint32_t, v); break;
+        case 0x36: STORE(uint32_t); break;
+        case 0x37: STORE(uint64_t); break;
+        case 0x3a: STORE(uint8_t); break;
+        case 0x3b: STORE(uint16_t); break;
+        case 0x3c: STORE(uint8_t); break;
+        case 0x3d: STORE(uint16_t); break;
+        case 0x3e: STORE(uint32_t); break;
+
+        /* ---- constants ---- */
+        case 0x41: *sp++ = imm32(pc); pc += 4; break;
+        case 0x42: *sp++ = imm64(pc); pc += 8; break;
+
+        /* ---- i32 comparisons ---- */
+        case 0x45: UN32(a == 0); break;
+        case 0x46: BIN32(a == b); break;
+        case 0x47: BIN32(a != b); break;
+        case 0x48: BIN32((int32_t)a < (int32_t)b); break;
+        case 0x49: BIN32(a < b); break;
+        case 0x4a: BIN32((int32_t)a > (int32_t)b); break;
+        case 0x4b: BIN32(a > b); break;
+        case 0x4c: BIN32((int32_t)a <= (int32_t)b); break;
+        case 0x4d: BIN32(a <= b); break;
+        case 0x4e: BIN32((int32_t)a >= (int32_t)b); break;
+        case 0x4f: BIN32(a >= b); break;
+
+        /* ---- i64 comparisons (i32 results) ---- */
+        case 0x50: UN64(a == 0); break;
+        case 0x51: BIN64(a == b); break;
+        case 0x52: BIN64(a != b); break;
+        case 0x53: BIN64((int64_t)a < (int64_t)b); break;
+        case 0x54: BIN64(a < b); break;
+        case 0x55: BIN64((int64_t)a > (int64_t)b); break;
+        case 0x56: BIN64(a > b); break;
+        case 0x57: BIN64((int64_t)a <= (int64_t)b); break;
+        case 0x58: BIN64(a <= b); break;
+        case 0x59: BIN64((int64_t)a >= (int64_t)b); break;
+        case 0x5a: BIN64(a >= b); break;
+
+        /* ---- i32 arithmetic ---- */
+        case 0x67: UN32(clz32(a)); break;
+        case 0x68: UN32(ctz32(a)); break;
+        case 0x69: UN32(ctpop32(a)); break;
+        case 0x6a: BIN32(a + b); break;
+        case 0x6b: BIN32(a - b); break;
+        case 0x6c: BIN32(a * b); break;
+        case 0x6d: {
+            uint32_t b = (uint32_t)*--sp, a = (uint32_t)sp[-1];
+
+            if (b == 0 || ((int32_t)a == INT32_MIN && (int32_t)b == -1)) {
+                interp_trap("i32.div_s");
+            }
+            sp[-1] = (uint32_t)((int32_t)a / (int32_t)b);
+            break;
+        }
+        case 0x6e: {
+            uint32_t b = (uint32_t)*--sp, a = (uint32_t)sp[-1];
+
+            if (b == 0) {
+                interp_trap("i32.div_u");
+            }
+            sp[-1] = a / b;
+            break;
+        }
+        case 0x6f: {
+            uint32_t b = (uint32_t)*--sp, a = (uint32_t)sp[-1];
+
+            if (b == 0) {
+                interp_trap("i32.rem_s");
+            }
+            sp[-1] = (int32_t)b == -1 ? 0 : (uint32_t)((int32_t)a % (int32_t)b);
+            break;
+        }
+        case 0x70: {
+            uint32_t b = (uint32_t)*--sp, a = (uint32_t)sp[-1];
+
+            if (b == 0) {
+                interp_trap("i32.rem_u");
+            }
+            sp[-1] = a % b;
+            break;
+        }
+        case 0x71: BIN32(a & b); break;
+        case 0x72: BIN32(a | b); break;
+        case 0x73: BIN32(a ^ b); break;
+        case 0x74: BIN32(a << (b & 31)); break;
+        case 0x75: BIN32((int32_t)a >> (b & 31)); break;
+        case 0x76: BIN32(a >> (b & 31)); break;
+        case 0x77: BIN32(rol32(a, b & 31)); break;
+        case 0x78: BIN32(ror32(a, b & 31)); break;
+
+        /* ---- i64 arithmetic ---- */
+        case 0x79: UN64(clz64(a)); break;
+        case 0x7a: UN64(ctz64(a)); break;
+        case 0x7b: UN64(ctpop64(a)); break;
+        case 0x7c: BIN64(a + b); break;
+        case 0x7d: BIN64(a - b); break;
+        case 0x7e: BIN64(a * b); break;
+        case 0x7f: {
+            uint64_t b = *--sp, a = sp[-1];
+
+            if (b == 0 || ((int64_t)a == INT64_MIN && (int64_t)b == -1)) {
+                interp_trap("i64.div_s");
+            }
+            sp[-1] = (uint64_t)((int64_t)a / (int64_t)b);
+            break;
+        }
+        case 0x80: {
+            uint64_t b = *--sp, a = sp[-1];
+
+            if (b == 0) {
+                interp_trap("i64.div_u");
+            }
+            sp[-1] = a / b;
+            break;
+        }
+        case 0x81: {
+            uint64_t b = *--sp, a = sp[-1];
+
+            if (b == 0) {
+                interp_trap("i64.rem_s");
+            }
+            sp[-1] = (int64_t)b == -1 ? 0 : (uint64_t)((int64_t)a % (int64_t)b);
+            break;
+        }
+        case 0x82: {
+            uint64_t b = *--sp, a = sp[-1];
+
+            if (b == 0) {
+                interp_trap("i64.rem_u");
+            }
+            sp[-1] = a % b;
+            break;
+        }
+        case 0x83: BIN64(a & b); break;
+        case 0x84: BIN64(a | b); break;
+        case 0x85: BIN64(a ^ b); break;
+        case 0x86: BIN64(a << (b & 63)); break;
+        case 0x87: BIN64((int64_t)a >> (b & 63)); break;
+        case 0x88: BIN64(a >> (b & 63)); break;
+        case 0x89: BIN64(rol64(a, b & 63)); break;
+        case 0x8a: BIN64(ror64(a, b & 63)); break;
+
+        /* ---- conversions ---- */
+        case 0xa7: UN64((uint32_t)a); break;
+        case 0xac: UN64((int64_t)(int32_t)a); break;
+        case 0xad: UN64((uint32_t)a); break;
+        case 0xc0: UN32((int32_t)(int8_t)a); break;
+        case 0xc1: UN32((int32_t)(int16_t)a); break;
+        case 0xc2: UN64((int64_t)(int8_t)a); break;
+        case 0xc3: UN64((int64_t)(int16_t)a); break;
+        case 0xc4: UN64((int64_t)(int32_t)a); break;
+
+        default:
+            interp_trap("bad decoded opcode");
+        }
+#undef BIN32
+#undef BIN64
+#undef UN32
+#undef UN64
+#undef LOAD
+#undef STORE
+    }
+}
diff --git a/tcg/wasm32/wasi_platform.h b/tcg/wasm32/wasi_platform.h
new file mode 100644
index 0000000..8c1a415
--- /dev/null
+++ b/tcg/wasm32/wasi_platform.h
@@ -0,0 +1,81 @@
+/*
+ * WASI Platform Adaptation Layer for QEMU
+ *
+ * Replaces emscripten-specific APIs with WASI equivalents.
+ * This header provides the interface that QEMU's wasm32 TCG backend
+ * and other components use instead of emscripten functions.
+ */
+
+#ifndef WASI_PLATFORM_H
+#define WASI_PLATFORM_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+
+/*
+ * Context structure and offset macros.
+ *
+ * If wasm32.h was already included (via ../wasm32.h in tcg-target.c.inc),
+ * then struct wasmContext and the offset macros are already defined.
+ * Only define them if wasm32.h hasn't been included yet.
+ */
+#ifndef TCG_WASM32_H
+
+struct wasmContext {
+    /* offset 0 */
+    void *env;           /* CPUArchState *env */
+    /* offset 4 */
+    uint64_t *stack;     /* TCG call stack */
+    /* offset 8 */
+    uint32_t *tb_ptr;    /* current translation block pointer */
+    /* offset 12 */
+    uint32_t *tci_tb_ptr; /* pointer to tci_tb_ptr thread-local */
+    /* offset 16 */
+    uint32_t do_init;    /* re-initialization flag */
+    /* offset 20 */
+    uint32_t done_flag;  /* helper completion flag */
+    /* offset 24 */
+    uint64_t *stack128;  /* 128-bit op stack */
+    /* offset 28 */
+    uint32_t unwinding;  /* coroutine unwind flag */
+};
+
+/* Field offsets - must match struct layout above */
+#define ENV_OFF          0
+#define STACK_OFF        4
+#define TB_PTR_OFF       8
+#define HELPER_RET_TB_PTR_OFF 12
+#define DO_INIT_OFF      16
+#define DONE_FLAG_OFF    20
+#define STACK128_OFF     24
+#define UNWINDING_OFF    28
+
+#endif /* !TCG_WASM32_H */
+
+/*
+ * TBs per slice with QEMU_TB_SLICE=<count> (see tcg/wasm32.c: slices are
+ * normally timed instead); ~4000 TBs is well under a millisecond.
+ */
+#define WASI_TB_YIELD_SLICE 4000
+
+/*
+ * Set the done flag after helper function completion.
+ * Called from ldst helpers to signal that a memory access is complete.
+ */
+void set_done_flag(void);
+
+/*
+ * Set the unwinding flag when a coroutine switch is needed.
+ * Causes the currently executing wasm TB to return early.
+ */
+void set_unwinding_flag(void);
+
+/*
+ * Get the number of logical cores available.
+ * For WASI single-threaded: returns 1
+ * For WASI with wasi-threads: returns actual core count
+ */
+int get_core_nums(void);
+
+#endif /* WASI_PLATFORM_H */
