+static void tcg_out_op_cond_i64(TCGContext *s, TCGCond cond, TCGReg arg1, TCGReg arg2)
+{
+    uint8_t op = tcg_cond_to_inst[cond].i64;
+    tcg_out_op_global_get_r(s, arg1);
+    tcg_out_op_global_get_r(s, arg2);
+    tcg_out8(s, op);
+}
+
+/*
+ * Type-aware comparison. Registers are 64-bit wasm globals, but the high
+ * 32 bits of a TCG_TYPE_I32 value are undefined (i32 arithmetic ops such as
+ * add_i32 are lowered to i64.add without masking). Using i64 comparison
+ * opcodes on such values is incorrect (especially unsigned ordering, which
+ * depends on the high bits). For i32 conditions we therefore wrap both
+ * operands to 32 bits and use the i32 comparison opcodes. The result is an
+ * i32 boolean in both cases.
+ */
+static void tcg_out_op_cond(TCGContext *s, TCGType type, TCGCond cond,
+                            TCGReg arg1, TCGReg arg2)
+{
+    if (type == TCG_TYPE_I32) {
+        uint8_t op = tcg_cond_to_inst[cond].i32;
+        tcg_out_op_global_get_r(s, arg1);
+        tcg_out_op_i32_wrap_i64(s);
+        tcg_out_op_global_get_r(s, arg2);
+        tcg_out_op_i32_wrap_i64(s);
+        tcg_out8(s, op);
+    } else {
+        tcg_out_op_cond_i64(s, cond, arg1, arg2);
+    }
+}
+
+#define tcg_out_i64_calc(op)                                            \
+    static void tcg_out_i64_calc_##op(TCGContext *s, TCGReg ret, TCGReg arg1, TCGReg arg2){ \
+        tcg_out_op_global_get_r(s, arg1);                               \
+        tcg_out_op_global_get_r(s, arg2);                               \
+        tcg_out_op_i64_##op(s);                                         \
+        tcg_out_op_global_set_r(s, ret);                                \
+    }
+tcg_out_i64_calc(and);
+tcg_out_i64_calc(or);
+tcg_out_i64_calc(xor);
+tcg_out_i64_calc(shl);
+tcg_out_i64_calc(shr_s);
+tcg_out_i64_calc(shr_u);
+tcg_out_i64_calc(rotl);
+tcg_out_i64_calc(rotr);
+tcg_out_i64_calc(add);
+tcg_out_i64_calc(sub);
+tcg_out_i64_calc(mul);
+tcg_out_i64_calc(div_s);
+tcg_out_i64_calc(div_u);
+tcg_out_i64_calc(rem_s);
+tcg_out_i64_calc(rem_u);
+
+/* ret = arg1 OPC arg2 computed with a 32-bit wasm opcode (shifts). */
+static void tcg_out_i32_binop(TCGContext *s, uint8_t opc, TCGReg ret,
+                              TCGReg arg1, TCGReg arg2)
+{
+    tcg_out_op_global_get_r(s, arg1);
+    tcg_out_op_i32_wrap_i64(s);
+    tcg_out_op_global_get_r(s, arg2);
+    tcg_out_op_i32_wrap_i64(s);
+    tcg_out8(s, opc);
+    tcg_out_op_i64_extend_i32_u(s);
+    tcg_out_op_global_set_r(s, ret);
+}
+
+static void tcg_out_get_i32_ext(TCGContext *s, TCGReg r, bool sign);
+
+/*
+ * 32-bit division and remainder, done in 64 bits on properly extended
+ * operands: the result is the same, and INT32_MIN / -1 cannot trap.
+ * opc64 is the i64 div/rem opcode.
+ */
+static void tcg_out_i32_divrem(TCGContext *s, uint8_t opc64, bool sign,
+                               TCGReg ret, TCGReg arg1, TCGReg arg2)
+{
+    tcg_out_get_i32_ext(s, arg1, sign);
+    tcg_out_get_i32_ext(s, arg2, sign);
+    tcg_out8(s, opc64);
+    tcg_out_op_global_set_r(s, ret);
+}
