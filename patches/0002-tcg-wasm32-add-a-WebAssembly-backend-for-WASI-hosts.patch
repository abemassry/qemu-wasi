diff --git a/tcg/wasi_jit.h b/tcg/wasi_jit.h
new file mode 100644
index 0000000..b3b948d
--- /dev/null
+++ b/tcg/wasi_jit.h
@@ -0,0 +1,77 @@
+/*
+ * WASI JIT Host Extension - C bindings (Simple Extern version)
+ *
+ * Plain extern functions imported from the "env" module.
+ * The host (m-browser) implements these in Rust via wasmtime::Linker.
+ */
+
+#ifndef WASI_JIT_H
+#define WASI_JIT_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+/*
+ * Compile wasm bytes into a callable module.
+ * Returns a handle (>0) on success, 0 on failure.
+ *
+ * @wasm_bytes:         pointer to wasm bytecode in guest linear memory
+ * @wasm_bytes_len:     length in bytes
+ * @helper_func_indices: pointer to array of uint32 table indices
+ * @helper_func_count:  number of helper functions
+ */
+extern uint32_t wasi_jit_compile(
+    const uint8_t *wasm_bytes,
+    uint32_t wasm_bytes_len,
+    const uint32_t *helper_func_indices,
+    uint32_t helper_func_count);
+
+/*
+ * Like wasi_jit_compile, but only if the host has an identical module
+ * compiled already (it keeps recently compiled modules); returns 0 instead
+ * of compiling.
+ */
+extern uint32_t wasi_jit_load_cached(
+    const uint8_t *wasm_bytes,
+    uint32_t wasm_bytes_len,
+    const uint32_t *helper_func_indices,
+    uint32_t helper_func_count);
+
+/*
+ * Like wasi_jit_compile when the host has the module compiled already.
+ * Otherwise the host compiles it on another thread and returns 0: run the
+ * TB some other way and ask again later.  Returns WASI_JIT_FAILED once the
+ * host has failed to compile the module.
+ */
+extern uint32_t wasi_jit_load_async(
+    const uint8_t *wasm_bytes,
+    uint32_t wasm_bytes_len,
+    const uint32_t *helper_func_indices,
+    uint32_t helper_func_count);
+#define WASI_JIT_FAILED 0xffffffffu
+
+/*
+ * Call a compiled module's start function.
+ *
+ * @module_handle: handle returned by wasi_jit_compile
+ * @ctx_ptr:       pointer to TCG CPUArchState in guest memory
+ * Returns:        next TB pointer (guest address)
+ */
+extern uint32_t wasi_jit_call(uint32_t module_handle, uint32_t ctx_ptr);
+
+/*
+ * Release a compiled module and free its resources.
+ */
+extern void wasi_jit_drop(uint32_t module_handle);
+
+/*
+ * Returns 1 (and clears the flag) if the most recent TB-helper call
+ * threw a wasm exception (typically: siglongjmp inside a QEMU helper
+ * such as helper_raise_exception → cpu_loop_exit). The host swallowed
+ * the exception (it cannot cross host frames) and set this flag so we
+ * can re-issue cpu_loop_exit() from main-module C code, where the
+ * resulting siglongjmp will be caught by sigsetjmp() in cpu_exec_loop.
+ */
+extern int wasi_jit_take_pending_exception(void);
+
+#endif /* WASI_JIT_H */
