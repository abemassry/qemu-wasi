+#elif defined(WASI_PLATFORM)
+/*
+ * WASI has no mmap. The wasm32 JIT backend stores wasm bytecode in this
+ * buffer (not native code), so we just need a plain heap allocation.
+ * Return PROT_READ|PROT_WRITE so the mprotect loop in tcg_region_init
+ * becomes a no-op (have_prot == need_prot).
+ */
+static int alloc_code_gen_buffer(size_t size, int splitwx, Error **errp)
+{
+    void *buf;
+
+    if (splitwx > 0) {
+        error_setg(errp, "jit split-wx not supported on WASI");
+        return -1;
+    }
+
+    buf = aligned_alloc(qemu_real_host_page_size(), size);
+    if (buf == NULL) {
+        error_setg_errno(errp, errno,
+                         "allocate %zu bytes for jit buffer", size);
+        return -1;
+    }
+    memset(buf, 0, size);
+
+    region.start_aligned = buf;
+    region.total_size = size;
+
+    return PROT_READ | PROT_WRITE;
+}
