+/* ================================================================== */
+/*  WASI-specific TB cache and JIT compilation                        */
+/* ================================================================== */
+
+#ifdef WASI_PLATFORM
+
+/*
+ * Compiled TB modules.
+ *
+ * Each TB carries a uint32 slot (see wasm_finalize_module) holding the
+ * host JIT handle of its compiled module, 0 if not compiled yet, so lookup
+ * is O(1).  Live handles are also tracked in a FIFO ring so that they can
+ * all be forgotten at once.
+ *
+ * Note that dropping a handle does not free anything on the host: wasmtime
+ * keeps every instance alive until its Store is dropped.  The host frees
+ * them by moving QEMU into a fresh Store between main loop iterations and
+ * then calling wasi_qemu_jit_reset().  The ring is therefore sized so that
+ * eviction, which only causes recompilation, practically never happens.
+ */
+#define TB_CACHE_MAX 65536
+
+struct tb_cache_entry {
+    uint32_t *slot;        /* the TB's handle slot in the code buffer */
+    uint32_t jit_handle;   /* handle from wasi_jit_compile */
+};
+
+static struct tb_cache_entry tb_cache[TB_CACHE_MAX];
+static unsigned tb_cache_head;   /* index of the oldest entry */
+static unsigned tb_cache_count;
+
+/*
+ * Per-TB execution state (see wasm_finalize_module): [0] JIT handle,
+ * [1] interpreter execution count, [2] decoded interpreter program.
+ */
+static inline uint32_t *tb_handle_slot(void *tb_ptr)
+{
+    uint8_t *base = (uint8_t *)tb_ptr;
+    /* export_vec_offset points at export_vec_size; the slots follow it. */
+    return (uint32_t *)(base + *(uint32_t *)base + 4);
+}
+
+#include "wasi-interp.c.inc"
+
+/*
+ * TBs executed so far, and the count at which the vCPU should next yield to
+ * the main loop (see cpu_handle_interrupt).  With TB chaining, a chain can
+ * run for a long time without returning to cpu_exec, so the dispatch loop
+ * below requests the exit itself.
+ */
+uint64_t wasi_tbs_executed;
+uint64_t wasi_tb_yield_at = WASI_TB_YIELD_SLICE;
+
+/*
+ * Slices.  The vCPU runs until its slice is over, then yields to the main
+ * loop, which runs QEMU's timers, devices and display.  On a busy guest the
+ * guest's own timer tick (1000 Hz in Alpine's kernel) is nearly always due
+ * by then, so every yield also costs the guest a tick, a couple of thousand
+ * TBs of interrupt handling.  With slices of a few thousand TBs that was
+ * about half of all the work: slices must be long enough to make ticks rare,
+ * but short enough for the display and input to stay smooth.
+ *
+ * QEMU_TB_SLICE_MS sets the slice's length in host time (default 30 ms); it
+ * is checked every WASI_SLICE_CHECK TBs.  QEMU_TB_SLICE=<count> makes slices
+ * a number of TBs instead, as they used to be (WASI_TB_YIELD_SLICE).
+ */
+#define WASI_SLICE_MS_DEFAULT 30
+#define WASI_SLICE_CHECK 1024
+
+static int64_t slice_ns = -1;       /* 0: slices are counted in TBs */
+static uint64_t slice_tbs;
+static int64_t slice_deadline;
+
+static void wasi_slice_settings(void)
+{
+    const char *count = getenv("QEMU_TB_SLICE");
+    const char *ms = getenv("QEMU_TB_SLICE_MS");
+
+    slice_tbs = count ? strtoull(count, NULL, 0) : 0;
+    if (slice_tbs) {
+        slice_ns = 0;
+    } else {
+        int64_t v = ms ? strtoll(ms, NULL, 0) : 0;
+
+        slice_ns = (v > 0 ? v : WASI_SLICE_MS_DEFAULT) * SCALE_MS;
+        slice_tbs = WASI_SLICE_CHECK;
+    }
+}
+
+/* TBs to run before checking whether the slice is over. */
+uint64_t wasi_tb_yield_slice(void)
+{
+    if (slice_ns < 0) {
+        wasi_slice_settings();
+    }
+    return slice_tbs;
+}
+
+/* A slice starts: called before the vCPU runs. */
+void wasi_slice_begin(void)
+{
+    if (slice_ns < 0) {
+        wasi_slice_settings();
+    }
+    if (slice_ns) {
+        slice_deadline = get_clock() + slice_ns;
+    }
+    wasi_tb_yield_at = wasi_tbs_executed + slice_tbs;
+}
+
+/* Whether the vCPU should yield now (asked every wasi_tb_yield_slice() TBs). */
+bool wasi_slice_over(void)
+{
+    return !slice_ns || get_clock() >= slice_deadline;
+}
+
+/*
+ * Coarse execution profile, printed every QEMU_PROF_EVERY seconds.
+ * TB execution time is estimated from timing every 256th TB.
+ */
+static struct {
+    uint64_t gen_ns, gen_n;             /* TB translation (tb_gen_code) */
+    uint64_t decode_ns, decode_n;       /* interpreter decoding */
+    uint64_t jit_ns, jit_n;             /* JIT compile + instantiate */
+    uint64_t interp_n, interp_ns, interp_samples;
+    uint64_t jit_exec_n, jit_exec_ns, jit_exec_samples;
+    uint64_t loop_ns, cpu_ns, idle_ns;  /* main loop, vCPU, sleeping */
+    /*
+     * Interpreted runs by how often the TB had run before: <50, 50-199,
+     * 200-999, 1000 up to QEMU_JIT_HOT, never compiled (JIT rejected it).
+     */
+    uint64_t interp_by_count[5];
+    uint64_t reached[3];                /* TBs reaching 50/200/1000 runs */
+    int64_t window_start;
+} wasi_prof;
+
+/*
+ * The coarse profile costs clock reads, which are host calls (about half a
+ * microsecond each), tens of thousands of times a second: only take them
+ * when QEMU_PROF_EVERY asks for the profile.
+ */
+static int wasi_prof_state = -1;    /* -1: not decided yet, 0: off, 1: on */
+
+static inline bool wasi_prof_enabled(void)
+{
+    if (unlikely(wasi_prof_state < 0)) {
+        const char *env = getenv("QEMU_PROF_EVERY");
+
+        wasi_prof_state = env && atoll(env) > 0;
+    }
+    return wasi_prof_state;
+}
+
+/* The time in ns if the coarse profile is on, else 0. */
+int64_t wasi_prof_clock(void)
+{
+    return wasi_prof_enabled() ? get_clock() : 0;
+}
+
+static inline int64_t prof_now(void)
+{
+    return wasi_prof_clock();
+}
+
+/*
+ * Count an interpreted run of a TB that had run @runs times before, for the
+ * profile's histogram: it shows what a lower QEMU_JIT_HOT would change.
+ */
+static inline void interp_count_run(uintptr_t prog, uint32_t runs)
+{
+    int bucket = (prog & INTERP_NO_JIT) ? 4 :
+                 runs < 50 ? 0 : runs < 200 ? 1 : runs < 1000 ? 2 : 3;
+
+    wasi_prof.interp_by_count[bucket]++;
+    if (runs == 49) {
+        wasi_prof.reached[0]++;
+    } else if (runs == 199) {
+        wasi_prof.reached[1]++;
+    } else if (runs == 999) {
+        wasi_prof.reached[2]++;
+    }
+}
+
+void wasi_prof_add_gen(int64_t ns)
+{
+    wasi_prof.gen_ns += ns;
+    wasi_prof.gen_n++;
+}
+
+void wasi_prof_add_loop(int64_t loop_ns, int64_t cpu_ns)
+{
+    wasi_prof.loop_ns += loop_ns;
+    wasi_prof.cpu_ns += cpu_ns;
+}
+
+void wasi_prof_add_idle(int64_t ns)
+{
+    wasi_prof.idle_ns += ns;
+}
+
+void wasi_prof_report_maybe(void)
+{
+    static int64_t every_ns = -1;
+    int64_t now;
+    double wall, interp_s, jit_s, other;
+
+    if (!wasi_prof_enabled()) {
+        return;
+    }
+    now = prof_now();
+    if (every_ns < 0) {
+        const char *env = getenv("QEMU_PROF_EVERY");
+        every_ns = env ? atoll(env) * NANOSECONDS_PER_SECOND : 0;
+        wasi_prof.window_start = now;
+    }
+    if (!every_ns || now - wasi_prof.window_start < every_ns) {
+        return;
+    }
+    wall = (now - wasi_prof.window_start) / 1e9;
+    interp_s = wasi_prof.interp_samples ?
+        (double)wasi_prof.interp_ns / wasi_prof.interp_samples * wasi_prof.interp_n / 1e9 : 0;
+    jit_s = wasi_prof.jit_exec_samples ?
+        (double)wasi_prof.jit_exec_ns / wasi_prof.jit_exec_samples * wasi_prof.jit_exec_n / 1e9 : 0;
+    other = wasi_prof.cpu_ns / 1e9 - wasi_prof.gen_ns / 1e9 - wasi_prof.decode_ns / 1e9
+            - wasi_prof.jit_ns / 1e9 - interp_s - jit_s;
+    fprintf(stderr, "[wasi-prof] %.0f s: translate %.1f s (%" PRIu64 " TBs, %.0f us each), "
+            "decode %.1f s, jit-compile %.1f s (%" PRIu64 "), "
+            "exec-interp ~%.1f s (%.1fM TBs, %.2f us each), "
+            "exec-jit ~%.1f s (%.1fM TBs, %.2f us each), other-cpu %.1f s, "
+            "main-loop %.1f s, idle %.1f s, memory %zu MiB\n",
+            wall, wasi_prof.gen_ns / 1e9, wasi_prof.gen_n,
+            wasi_prof.gen_n ? wasi_prof.gen_ns / 1e3 / wasi_prof.gen_n : 0.0,
+            wasi_prof.decode_ns / 1e9, wasi_prof.jit_ns / 1e9, wasi_prof.jit_n,
+            interp_s, wasi_prof.interp_n / 1e6,
+            wasi_prof.interp_samples ? wasi_prof.interp_ns / 1e3 / wasi_prof.interp_samples : 0.0,
+            jit_s, wasi_prof.jit_exec_n / 1e6,
+            wasi_prof.jit_exec_samples ? wasi_prof.jit_exec_ns / 1e3 / wasi_prof.jit_exec_samples : 0.0,
+            other, (wasi_prof.loop_ns - wasi_prof.idle_ns) / 1e9, wasi_prof.idle_ns / 1e9,
+            __builtin_wasm_memory_size(0) >> 4);
+    if (wasi_prof.interp_n) {
+        const uint64_t *c = wasi_prof.interp_by_count;
+        double n = wasi_prof.interp_n / 100.0;
+
+        fprintf(stderr, "[wasi-prof]   interpreted runs by how often the TB had run "
+                "before: <50 %.0f%%, 50-199 %.0f%%, 200-999 %.0f%%, 1000-%u %.0f%%, "
+                "never compiled %.0f%%; TBs reaching 50/200/1000 runs: %" PRIu64
+                "/%" PRIu64 "/%" PRIu64 "\n",
+                c[0] / n, c[1] / n, c[2] / n, interp_hot, c[3] / n, c[4] / n,
+                wasi_prof.reached[0], wasi_prof.reached[1], wasi_prof.reached[2]);
+    }
+    memset(&wasi_prof, 0, sizeof(wasi_prof));
+    wasi_prof.window_start = now;
+}
+
+/* One-line summary of how TBs are being executed, for diagnostics. */
+void wasi_tb_exec_report(FILE *f)
+{
+    fprintf(f, "[wasi-interp] %" PRIu64 " TBs decoded (%" PRIu64 " KiB), "
+            "%" PRIu64 " not interpretable, %" PRIu64 " invalid wasm, "
+            "%" PRIu64 " promoted to the JIT (threshold %u), %" PRIu64
+            " reloaded from its cache (after %u), %" PRIu64
+            " rejected by the JIT, %" PRIu64 " interpreted executions\n",
+            interp_stats.decoded, interp_stats.decoded_bytes >> 10,
+            interp_stats.unsupported, interp_stats.invalid,
+            interp_stats.promoted, interp_hot, interp_stats.reloaded,
+            interp_warm, interp_stats.jit_failed, interp_stats.execs);
+}
+
+static void evict_oldest_tbs(unsigned count)
+{
+    while (count-- && tb_cache_count) {
+        struct tb_cache_entry *e = &tb_cache[tb_cache_head];
+
+        if (*e->slot == e->jit_handle) {
+            *e->slot = 0;
+        }
+        wasi_jit_drop(e->jit_handle);
+        tb_cache_head = (tb_cache_head + 1) % TB_CACHE_MAX;
+        tb_cache_count--;
+    }
+}
+
+/*
+ * Drop every compiled module.  Called when QEMU flushes the TB code buffer
+ * (tcg_region_reset_all): the buffer is about to be reused for new TBs, so
+ * all slots in it are going away and the modules can never run again.
+ */
+void wasi_tb_cache_flush(void)
+{
+    static uint64_t flushes;
+
+    /*
+     * Every flush discards all translated code; each TB is then retranslated
+     * at a new address and recompiled by the host.  Frequent flushes mean
+     * the code buffer (-accel tcg,tb-size=N) is too small.
+     */
+    flushes++;
+    if (flushes <= 10 || flushes % 10 == 0) {
+        fprintf(stderr, "[qemu-wasi] TB buffer flush #%llu (%u compiled TBs dropped)\n",
+                (unsigned long long)flushes, tb_cache_count);
+        wasi_tb_exec_report(stderr);
+    }
+    interp_arena_retire();
+
+    while (tb_cache_count) {
+        wasi_jit_drop(tb_cache[tb_cache_head].jit_handle);
+        tb_cache_head = (tb_cache_head + 1) % TB_CACHE_MAX;
+        tb_cache_count--;
+    }
+    tb_cache_head = 0;
+}
+
+/*
+ * The host discarded every compiled module (it moved QEMU into a new
+ * wasmtime Store).  Clear the handle slots of all TBs that had one, so they
+ * are recompiled on their next execution; there is nothing to drop.
+ */
+void wasi_tb_cache_forget_all(void)
+{
+    while (tb_cache_count) {
+        struct tb_cache_entry *e = &tb_cache[tb_cache_head];
+
+        if (*e->slot == e->jit_handle) {
+            *e->slot = 0;
+        }
+        tb_cache_head = (tb_cache_head + 1) % TB_CACHE_MAX;
+        tb_cache_count--;
+    }
+    tb_cache_head = 0;
+}
+
+static void remember_compiled_tb(uint32_t *slot, uint32_t handle)
+{
+    if (tb_cache_count == TB_CACHE_MAX) {
+        evict_oldest_tbs(TB_CACHE_MAX / 4);
+    }
+    tb_cache[(tb_cache_head + tb_cache_count) % TB_CACHE_MAX] =
+        (struct tb_cache_entry){ .slot = slot, .jit_handle = handle };
+    tb_cache_count++;
+    *slot = handle;
+}
+
+/*
+ * Compile hot TBs in the background (see wasi_jit_load_async), asking the
+ * host every JIT_ASYNC_RETRY runs whether the module is ready.
+ */
+static bool jit_async;
+#define JIT_ASYNC_RETRY 16
+
+/* How compile_and_cache_tb() gets a module the host has not compiled yet. */
+enum {
+    JIT_COMPILE,    /* compile it now */
+    JIT_CACHED,     /* not at all: fail */
+    JIT_ASYNC,      /* in the background (wasi_jit_load_async): fail for now */
+};
+
+/*
+ * Get the TB's wasm module loaded by the host and record its handle; @mode
+ * says what to do if the host has no identical module compiled yet.
+ * Returns the handle, 0 if there is none (yet), or WASI_JIT_FAILED when
+ * the host's background compiler has rejected the module.
+ */
+static uint32_t compile_and_cache_tb(void *tb_ptr, int mode)
+{
+    uint8_t *base = (uint8_t *)tb_ptr;
+
+    uint32_t code_size = *(uint32_t *)(base + 4);
+    uint8_t *code_begin = base + 8;
+    uint32_t header_size = *(uint32_t *)(code_begin + code_size);
+    uint8_t *header_begin = code_begin + code_size + 4;
+    uint32_t import_vec_size = *(uint32_t *)(header_begin + header_size);
+    uint8_t *import_vec_begin = header_begin + header_size + 4;
+
+    /* Assemble the full wasm module: header + body */
+    size_t wasm_total = header_size + code_size;
+    uint8_t *wasm_bytes = (uint8_t *)malloc(wasm_total);
+    if (!wasm_bytes) {
+        fprintf(stderr, "qemu-wasi: OOM assembling wasm module\n");
+        return 0;
+    }
+    memcpy(wasm_bytes, header_begin, header_size);
+    memcpy(wasm_bytes + header_size, code_begin, code_size);
+
+    /*
+     * Debugging aid: QEMU_TB_DUMP=<pc>,<dir> writes the wasm module for the
+     * TB at guest pc <pc> (hex) to <dir>/tb_<pc>.wasm when it is compiled.
+     * Compilation happens just before a TB first runs, so the CPU's current
+     * pc identifies it.  Inspect with "wasm-tools print".
+     */
+    {
+        static int dump_state = -1;
+        static vaddr dump_pc;
+        static char dump_dir[256];
+
+        if (dump_state < 0) {
+            const char *spec = getenv("QEMU_TB_DUMP");
+            unsigned long long p;
+            dump_state = spec && sscanf(spec, "%llx,%255s", &p, dump_dir) == 2;
+            dump_pc = dump_state ? p : 0;
+        }
+        if (dump_state && current_cpu &&
+            current_cpu->cc->get_pc(current_cpu) == dump_pc) {
+            char path[320];
+            FILE *f;
+
+            snprintf(path, sizeof(path), "%s/tb_%llx.wasm", dump_dir,
+                     (unsigned long long)dump_pc);
+            f = fopen(path, "wb");
+            if (f) {
+                fwrite(wasm_bytes, 1, wasm_total, f);
+                fclose(f);
+                fprintf(stderr, "QEMU_TB_DUMP: wrote %s (%zu bytes)\n",
+                        path, wasm_total);
+            }
+        }
+    }
+
+    uint32_t num_helpers = import_vec_size / 4;
+    uint32_t *helper_indices = (uint32_t *)import_vec_begin;
+
+    uint32_t handle;
+
+    switch (mode) {
+    case JIT_COMPILE:
+        handle = wasi_jit_compile(wasm_bytes, wasm_total, helper_indices, num_helpers);
+        break;
+    case JIT_CACHED:
+        handle = wasi_jit_load_cached(wasm_bytes, wasm_total, helper_indices, num_helpers);
+        break;
+    default:
+        handle = wasi_jit_load_async(wasm_bytes, wasm_total, helper_indices, num_helpers);
+        break;
+    }
+
+    free(wasm_bytes);
+
+    if (handle == 0 || handle == WASI_JIT_FAILED) {
+        if (mode == JIT_COMPILE) {
+            fprintf(stderr, "qemu-wasi: JIT compile failed for TB at %p\n", tb_ptr);
+        }
+        return handle;
+    }
+
+    remember_compiled_tb(tb_handle_slot(tb_ptr), handle);
+    return handle;
+}
+
+#endif /* WASI_PLATFORM */
+
+/* ================================================================== */
+/*  Common state and execution                                        */
+/* ================================================================== */
+
+__thread struct wasmContext ctx = {
+    .tb_ptr = 0,
+    .stack = NULL,
+    .do_init = 1,
+    .stack128 = NULL,
+};
+
+void set_done_flag(void)
+{
+    ctx.done_flag = 1;
+}
+
+void set_unwinding_flag(void)
+{
+    ctx.unwinding = 1;
+}
+
+int get_core_nums(void)
+{
+#ifdef EMSCRIPTEN
+    return emscripten_num_logical_cores();
+#else
+    /* WASI: single-threaded for now */
+    return 1;
+#endif
+}
+
+#ifdef EMSCRIPTEN
+typedef uint32_t (*wasm_func_ptr)(struct wasmContext*);
+
+__thread bool initdone = false;
+__thread int cur_core_num = -1;
+__thread int all_cores_num = -1;
+int cur_core_num_max = 0;
+#endif
+
+extern unsigned int tcg_max_ctxs;
+
+uintptr_t QEMU_DISABLE_CFI tcg_qemu_tb_exec(CPUArchState *env, const void *v_tb_ptr)
+{
+#ifdef EMSCRIPTEN
+    if (!initdone) {
+        active_tbs_lim = ACTIVE_TBS_MAX / tcg_max_ctxs;
+        active_tbs_rmv = REMOVE_TBS_NUM / tcg_max_ctxs;
+        cur_core_num = qatomic_fetch_inc(&cur_core_num_max);
+        all_cores_num = get_core_nums();
+        ctx.stack = (uint64_t*)malloc((TCG_STATIC_CALL_ARGS_SIZE + TCG_STATIC_FRAME_SIZE) / sizeof(uint64_t));
+        ctx.stack128 = (uint64_t*)malloc((TCG_STATIC_CALL_ARGS_SIZE + TCG_STATIC_FRAME_SIZE) / sizeof(uint64_t));
+        initdone = true;
+    }
+    ctx.env = env;
+    ctx.tb_ptr = (uint32_t*)v_tb_ptr;
+    ctx.do_init = 1;
+    ctx.tci_tb_ptr = (uint32_t*)&tci_tb_ptr;
+    uint32_t prev_tb_ptr = 0;
+    while (true) {
+        int tb_entry_ptr = (uint32_t)ctx.tb_ptr + *(uint32_t*)ctx.tb_ptr + cur_core_num * 4;
+        if (*(uint32_t*)tb_entry_ptr == 0) {
+            prepare_wasm(ctx.tb_ptr, cur_core_num, all_cores_num);
+        }
+        uint32_t res = ((wasm_func_ptr)(*(uint32_t*)tb_entry_ptr))(&ctx);
+        if ((uint32_t)ctx.tb_ptr == 0) {
+            return res;
+        }
+    }
+#endif /* EMSCRIPTEN */
+
+#ifdef WASI_PLATFORM
+    static bool initialized = false;
+    static uint64_t exec_count = 0;
+
+    if (!initialized) {
+        ctx.stack = (uint64_t *)malloc(256 * sizeof(uint64_t));
+        ctx.stack128 = (uint64_t *)malloc(256 * sizeof(uint64_t));
+        initialized = true;
+    }
+
+    ctx.env = env;
+    ctx.tb_ptr = (uint32_t *)v_tb_ptr;
+    ctx.tci_tb_ptr = (uint32_t *)&tci_tb_ptr;
+
+    uint64_t call_n = exec_count++;
+    if (call_n < 5 || call_n % 10000000 == 0) {
+        WASI_LOG_V("[WASI_TB] exec#%llu env=%p tb_ptr=%p\n",
+                (unsigned long long)call_n, env, (void*)ctx.tb_ptr);
+    }
+
+    /*
+     * Decoded programs retired by a TB buffer flush can be freed now: no
+     * TB is executing.  QEMU_JIT_HOT sets how many interpreted runs make a
+     * TB hot enough to compile (0: always compile), QEMU_JIT_WARM after how
+     * many a TB whose module the host already has is loaded from its cache.
+     * QEMU_JIT_ASYNC=0 compiles hot TBs synchronously, as QEMU_JIT_HOT=0
+     * always does.
+     */
+    interp_free_retired();
+    {
+        static bool hot_read;
+
+        if (!hot_read) {
+            const char *env = getenv("QEMU_JIT_HOT");
+
+            hot_read = true;
+            if (env) {
+                interp_hot = strtoul(env, NULL, 0);
+            }
+            env = getenv("QEMU_JIT_WARM");
+            if (env) {
+                interp_warm = strtoul(env, NULL, 0);
+            }
+            env = getenv("QEMU_JIT_ASYNC");
+            jit_async = interp_hot > 0 && !(env && strcmp(env, "0") == 0);
+        }
+    }
+
+    while (1) {
+        uint32_t *slot = tb_handle_slot(ctx.tb_ptr);
+        uint32_t handle = slot[0];
+        uint32_t res;
+
+        wasi_tbs_executed++;
+
+        if (handle == 0) {
+            uintptr_t prog = slot[2];
+
+            if (prog == 0) {
+                int64_t t = prof_now();
+
+                prog = interp_decode(ctx.tb_ptr);
+                slot[2] = (uint32_t)prog;
+                wasi_prof.decode_ns += prof_now() - t;
+                wasi_prof.decode_n++;
+            }
+            if (prog != INTERP_UNSUPPORTED && !(prog & INTERP_NO_JIT) &&
+                slot[1] == interp_warm && interp_warm < interp_hot) {
+                /*
+                 * Translating the same guest code again (after a TB buffer
+                 * flush, say) gives the same module.  If the host still has
+                 * it compiled, the TB was hot before: run it compiled now
+                 * instead of interpreting it up to interp_hot times again.
+                 */
+                int64_t t = prof_now();
+
+                handle = compile_and_cache_tb(ctx.tb_ptr, JIT_CACHED);
+                wasi_prof.jit_ns += prof_now() - t;
+                if (handle) {
+                    wasi_prof.jit_n++;
+                    interp_stats.reloaded++;
+                }
+            } else if (jit_async && prog != INTERP_UNSUPPORTED &&
+                       !(prog & INTERP_NO_JIT) && slot[1] >= interp_hot &&
+                       (slot[1] - interp_hot) % JIT_ASYNC_RETRY == 0) {
+                /*
+                 * Hot: the host compiles the module on another thread, and
+                 * the TB stays interpreted until it is ready.
+                 */
+                int64_t t = prof_now();
+
+                handle = compile_and_cache_tb(ctx.tb_ptr, JIT_ASYNC);
+                wasi_prof.jit_ns += prof_now() - t;
+                if (handle == WASI_JIT_FAILED) {
+                    /* The JIT rejected it: keep interpreting this TB. */
+                    interp_stats.jit_failed++;
+                    prog |= INTERP_NO_JIT;
+                    slot[2] = (uint32_t)prog;
+                    handle = 0;
+                } else if (handle) {
+                    wasi_prof.jit_n++;
+                    interp_stats.promoted++;
+                }
+            }
+            if (handle == 0 && prog != INTERP_UNSUPPORTED &&
+                ((prog & INTERP_NO_JIT) || slot[1] < interp_hot || jit_async)) {
+                interp_count_run(prog, slot[1]++);
+                interp_stats.execs++;
+                wasi_prof.interp_n++;
+                if ((wasi_prof.interp_n & 255) == 0) {
+                    int64_t t = prof_now();
+
+                    res = interp_exec(INTERP_PROG(prog), &ctx);
+                    wasi_prof.interp_ns += prof_now() - t;
+                    wasi_prof.interp_samples++;
+                } else {
+                    res = interp_exec(INTERP_PROG(prog), &ctx);
+                }
+                goto next_tb;
+            }
+        }
+        if (handle == 0) {
+            uintptr_t prog = slot[2];
+
+            if (prog != INTERP_UNSUPPORTED) {
+                interp_stats.promoted++;
+            }
+            {
+                int64_t t = prof_now();
+
+                handle = compile_and_cache_tb(ctx.tb_ptr, JIT_COMPILE);
+                wasi_prof.jit_ns += prof_now() - t;
+                wasi_prof.jit_n++;
+            }
+            if (handle == 0) {
+                if (prog == INTERP_UNSUPPORTED) {
+                    /*
+                     * Neither tier can run this TB.  Returning would just
+                     * retry it forever, so stop with a clear error.
+                     */
+                    fprintf(stderr, "qemu-wasi: fatal: TB %p can be neither "
+                            "compiled nor interpreted\n", (void *)ctx.tb_ptr);
+                    abort();
+                }
+                /* The JIT rejected it: keep interpreting this TB. */
+                interp_stats.jit_failed++;
+                slot[2] = (uint32_t)(prog | INTERP_NO_JIT);
+                slot[1]++;
+                interp_stats.execs++;
+                res = interp_exec(INTERP_PROG(prog), &ctx);
+                goto next_tb;
+            }
+        }
+
+        /*
+         * The handle is the index of the TB's entry function in QEMU's own
+         * function table (the host put it there when it instantiated the
+         * TB module), so this is an ordinary indirect call: wasm to wasm,
+         * with no host frame in between.  A helper that throws (siglongjmp
+         * from cpu_loop_exit) therefore unwinds through the TB directly to
+         * cpu_exec's sigsetjmp.
+         */
+        typedef uint32_t (*wasi_tb_entry_fn)(struct wasmContext *);
+        wasi_prof.jit_exec_n++;
+        if ((wasi_prof.jit_exec_n & 255) == 0) {
+            int64_t t = prof_now();
+
+            res = ((wasi_tb_entry_fn)(uintptr_t)handle)(&ctx);
+            wasi_prof.jit_exec_ns += prof_now() - t;
+            wasi_prof.jit_exec_samples++;
+        } else {
+            res = ((wasi_tb_entry_fn)(uintptr_t)handle)(&ctx);
+        }
+
+    next_tb:
+        if ((uint32_t)(uintptr_t)ctx.tb_ptr == 0) {
+            return res;
+        }
+        if (unlikely(wasi_tbs_executed >= wasi_tb_yield_at) && current_cpu) {
+            /*
+             * Time to let the main loop run timers.  Do what a timer kick
+             * does on other hosts: make the next TB exit at its start check.
+             * cpu_exec then restores the guest pc from that TB, which is
+             * correct whether or not the TBs are position-relative.
+             */
+            qatomic_set(&current_cpu->neg.icount_decr.u16.high, -1);
+        }
+
+        /*
+         * Continue with the TB that goto_ptr or goto_tb selected.  Each call
+         * of a TB's function runs it from its first instruction: on WASI
+         * nothing re-enters a TB half way, so there is no do_init flag or
+         * resume point (see REG_LOCAL_BASE in tcg-target.c.inc).
+         */
+    }
+#endif /* WASI_PLATFORM */
+}
+
+#endif /* !CONFIG_TCG_INTERPRETER && (EMSCRIPTEN || WASI_PLATFORM) */
