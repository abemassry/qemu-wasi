diff --git a/tcg/wasm32/tcg-wasm32-helpers.c.inc b/tcg/wasm32/tcg-wasm32-helpers.c.inc
new file mode 100644
index 0000000..ce40021
--- /dev/null
+++ b/tcg/wasm32/tcg-wasm32-helpers.c.inc
@@ -0,0 +1,724 @@
+/*
+ * TCG wasm32 backend helper functions
+ *
+ * These functions manage wasm module construction during TCG code generation:
+ * - Block index allocation for structured control flow
+ * - Label-to-block mapping for branch resolution
+ * - Helper function registration for wasm import table
+ * - LEB128 encoding utilities
+ *
+ * This file is #include'd from tcg.c when building for wasm32.
+ */
+
+#ifndef TCG_WASM32_HELPERS_INC
+#define TCG_WASM32_HELPERS_INC
+
+#include <string.h>
+
+/*
+ * Maximum limits for wasm module construction.
+ * These are generous limits; typical QEMU translation blocks
+ * use far fewer blocks/helpers.
+ */
+#define WASM_MAX_BLOCKS         4096
+#define WASM_MAX_LABEL_CONTEXTS 4096
+#define WASM_MAX_HELPERS        1024
+#define WASM_HELPER_TYPES_SIZE  (64 * 1024)  /* 64KB for type signatures */
+
+/*
+ * Per-label context: maps a TCG label ID to a wasm block index.
+ * Used to resolve branch targets in the generated wasm module.
+ */
+typedef struct WasmLabelContext {
+    int label;       /* TCG label ID */
+    int block_idx;   /* wasm block index */
+} WasmLabelContext;
+
+/*
+ * Per-label block pointer placeholder: records the position in the
+ * code buffer where a branch target block index needs to be patched.
+ */
+typedef struct WasmLabelPlaceholder {
+    int label;           /* TCG label ID */
+    uintptr_t code_pos;  /* position in code_buf to patch */
+} WasmLabelPlaceholder;
+
+/*
+ * Helper function registration: maps function pointers to wasm import indices.
+ */
+typedef struct WasmHelperEntry {
+    int func_idx;   /* wasm function table index */
+    int func_id;    /* function pointer (cast to int) */
+} WasmHelperEntry;
+
+/*
+ * Per-TCG-context wasm module construction state.
+ * This is allocated lazily on first use and freed with the TCGContext.
+ */
+typedef struct WasmModuleState {
+    /* Block index allocation */
+    int block_idx_counter;
+
+    /* Label-to-block mappings */
+    WasmLabelContext label_contexts[WASM_MAX_LABEL_CONTEXTS];
+    int num_label_contexts;
+
+    /* Label placeholder positions (for patching before instantiation) */
+    WasmLabelPlaceholder label_placeholders[WASM_MAX_LABEL_CONTEXTS];
+    int num_label_placeholders;
+
+    /* Helper function registry */
+    WasmHelperEntry helpers[WASM_MAX_HELPERS];
+    int num_helpers;
+
+    /* Helper function type signatures buffer */
+    uint8_t helper_types[WASM_HELPER_TYPES_SIZE];
+    int helper_types_pos;
+} WasmModuleState;
+
+/*
+ * Thread-local wasm module state.
+ * Allocated once per TCG context and reused across translation blocks.
+ * Reset at the start of each TB translation.
+ */
+static __thread WasmModuleState *wasm_state = NULL;
+
+static WasmModuleState *get_wasm_state(TCGContext *s)
+{
+    (void)s;
+    if (!wasm_state) {
+        wasm_state = g_malloc0(sizeof(WasmModuleState));
+    }
+    return wasm_state;
+}
+
+/*
+ * Reset wasm module state at the start of each translation block.
+ * Called from tcg_out_init (which is called at the start of each TB).
+ */
+static void wasm_reset_state(TCGContext *s)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    /*
+     * Block index 0 belongs to the implicit first block opened by the
+     * prologue (guarded by "BLOCK_PTR <= 0"), so allocation starts at 1.
+     * Starting at 0 gave the first label the same index as that block: a
+     * branch to the label re-ran the TB from its first instruction.  x86
+     * "rep" ops branch back to such a label when ECX hits 0, which
+     * duplicated pushes ("push;...;rep movsl" returned to a bogus address)
+     * or reloaded ECX and looped forever ("mov ecx,ebx; rep movsb").
+     */
+    ws->block_idx_counter = 1;
+    ws->num_label_contexts = 0;
+    ws->num_label_placeholders = 0;
+    ws->num_helpers = 0;
+    ws->helper_types_pos = 0;
+}
+
+/* ---- Block index management ---- */
+
+/*
+ * Allocate a new wasm block index.
+ * Each wasm structured control flow block gets a unique index.
+ * The block_ptr global variable is compared against these indices
+ * to determine which code path to execute.
+ */
+int wasm_alloc_block_idx(TCGContext *s)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    return ws->block_idx_counter++;
+}
+
+/*
+ * Get the current (most recently allocated) block index.
+ */
+int wasm_block_current_idx(TCGContext *s)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    return ws->block_idx_counter - 1;
+}
+
+/* ---- Label management ---- */
+
+/*
+ * Associate a TCG label with a wasm block index.
+ * When a branch to this label is taken, execution continues
+ * at the block with this index.
+ */
+void wasm_add_label_context(TCGContext *s, int label, int block_idx)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    tcg_debug_assert(ws->num_label_contexts < WASM_MAX_LABEL_CONTEXTS);
+    ws->label_contexts[ws->num_label_contexts].label = label;
+    ws->label_contexts[ws->num_label_contexts].block_idx = block_idx;
+    ws->num_label_contexts++;
+}
+
+/*
+ * Record a placeholder in the code buffer for a branch target.
+ * Before the wasm module is instantiated, these placeholders are
+ * patched with the actual block indices using fill_uint32_leb128.
+ *
+ * The placeholder is at the current code_ptr position in the TCG buffer.
+ * It's a 5-byte LEB128 slot (i64.const operand) that will be filled
+ * with the block index for the given label.
+ */
+void wasm_add_label_block_ptr_placeholder(TCGContext *s, int label)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    tcg_debug_assert(ws->num_label_placeholders < WASM_MAX_LABEL_CONTEXTS);
+    ws->label_placeholders[ws->num_label_placeholders].label = label;
+    ws->label_placeholders[ws->num_label_placeholders].code_pos =
+        (uintptr_t)(s->code_ptr);
+    ws->num_label_placeholders++;
+}
+
+/* ---- Helper function type signatures ---- */
+
+/*
+ * Get a pointer to the current position in the helper types buffer.
+ * The caller writes the wasm function type signature starting here.
+ */
+uint8_t *wasm_get_helper_types_begin(TCGContext *s)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    tcg_debug_assert(ws->helper_types_pos < WASM_HELPER_TYPES_SIZE);
+    return &ws->helper_types[ws->helper_types_pos];
+}
+
+/*
+ * Advance the helper types buffer position by sz bytes.
+ * Called after writing a function type signature.
+ */
+void wasm_add_helper_types_pos(TCGContext *s, int sz)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    ws->helper_types_pos += sz;
+    tcg_debug_assert(ws->helper_types_pos <= WASM_HELPER_TYPES_SIZE);
+}
+
+/* ---- Helper function registry ---- */
+
+/*
+ * Look up a helper function by its function ID (pointer cast to int).
+ * Returns the wasm function table index, or -1 if not found.
+ */
+int get_wasm_helper_idx(TCGContext *s, int func_id)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    for (int i = 0; i < ws->num_helpers; i++) {
+        if (ws->helpers[i].func_id == func_id) {
+            return ws->helpers[i].func_idx;
+        }
+    }
+    return -1;
+}
+
+/*
+ * Allocate a new helper function index.
+ * Returns a sequential index starting from 0.
+ */
+int wasm_register_helper_alloc_num(TCGContext *s)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    tcg_debug_assert(ws->num_helpers < WASM_MAX_HELPERS);
+    return ws->num_helpers;
+}
+
+/*
+ * Register a helper function mapping: func_idx -> func_id.
+ * func_idx is the wasm import table index (from wasm_register_helper_alloc_num).
+ * func_id is the function pointer (cast to int) that identifies the helper.
+ */
+void wasm_register_helper(TCGContext *s, int func_idx, int func_id)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    tcg_debug_assert(func_idx == ws->num_helpers);
+    ws->helpers[ws->num_helpers].func_idx = func_idx;
+    ws->helpers[ws->num_helpers].func_id = func_id;
+    ws->num_helpers++;
+}
+
+/* ---- LEB128 encoding ---- */
+
+/*
+ * Write a uint32 value in LEB128 encoding to a 5-byte slot.
+ * This is used to patch placeholder i64.const operands in the
+ * generated wasm bytecode before module instantiation.
+ *
+ * The 5-byte slot was pre-allocated with 0x80 continuation bytes
+ * and a 0x00 terminator. This function fills it with the actual value.
+ */
+void fill_uint32_leb128(uintptr_t addr, uint32_t value)
+{
+    uint8_t *p = (uint8_t *)addr;
+    /* Write exactly 5 bytes of LEB128 (padded with continuation bits) */
+    p[0] = (value & 0x7f) | 0x80;
+    p[1] = ((value >> 7) & 0x7f) | 0x80;
+    p[2] = ((value >> 14) & 0x7f) | 0x80;
+    p[3] = ((value >> 21) & 0x7f) | 0x80;
+    p[4] = (value >> 28) & 0x0f;  /* last byte: no continuation bit */
+}
+
+/*
+ * Resolve all label placeholders.
+ * Called after TCG code generation is complete, before the wasm module
+ * is compiled. Patches each placeholder with the block index for its label.
+ */
+void wasm_resolve_label_placeholders(TCGContext *s)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    for (int i = 0; i < ws->num_label_placeholders; i++) {
+        int label = ws->label_placeholders[i].label;
+        uintptr_t code_pos = ws->label_placeholders[i].code_pos;
+
+        /* Find the block index for this label */
+        int block_idx = -1;
+        for (int j = 0; j < ws->num_label_contexts; j++) {
+            if (ws->label_contexts[j].label == label) {
+                block_idx = ws->label_contexts[j].block_idx;
+                break;
+            }
+        }
+        tcg_debug_assert(block_idx >= 0);
+        fill_uint32_leb128(code_pos, (uint32_t)block_idx);
+    }
+}
+
+/*
+ * Get the helper function registry for use during wasm module compilation.
+ * Returns the array of helper entries and sets *count to the number of entries.
+ */
+const WasmHelperEntry *wasm_get_helpers(TCGContext *s, int *count)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    *count = ws->num_helpers;
+    return ws->helpers;
+}
+
+/*
+ * Get the helper type signatures buffer.
+ * Returns the buffer pointer and sets *size to the used size.
+ */
+const uint8_t *wasm_get_helper_types(TCGContext *s, int *size)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    *size = ws->helper_types_pos;
+    return ws->helper_types;
+}
+
+/* ---- LEB128 writing to arbitrary buffer ---- */
+
+/*
+ * Write an unsigned LEB128 value to buf, return number of bytes written.
+ */
+static int write_leb128_u32(uint8_t *buf, uint32_t v)
+{
+    int n = 0;
+    do {
+        uint8_t byte = v & 0x7f;
+        v >>= 7;
+        if (v != 0) byte |= 0x80;
+        buf[n++] = byte;
+    } while (v != 0);
+    return n;
+}
+
+/*
+ * Write a signed LEB128 value to buf (for i64.const), return bytes written.
+ */
+static int write_sleb128_i64(uint8_t *buf, int64_t v)
+{
+    int n = 0;
+    int more = 1;
+    while (more) {
+        uint8_t byte = v & 0x7f;
+        v >>= 7;
+        if ((v == 0 && !(byte & 0x40)) || (v == -1 && (byte & 0x40))) {
+            more = 0;
+        } else {
+            byte |= 0x80;
+        }
+        buf[n++] = byte;
+    }
+    return n;
+}
+
+/* ---- Wasm section helpers ---- */
+
+/*
+ * Write a wasm section: section_id + LEB128(size) + data.
+ * Returns total bytes written.
+ */
+static int write_wasm_section(uint8_t *out, uint8_t section_id,
+                              const uint8_t *data, int data_len)
+{
+    int pos = 0;
+    out[pos++] = section_id;
+    pos += write_leb128_u32(out + pos, data_len);
+    memcpy(out + pos, data, data_len);
+    pos += data_len;
+    return pos;
+}
+
+/*
+ * wasm_finalize_module: Construct the complete wasm module binary layout
+ * in the TCG code buffer after all TCG bytecodes have been emitted.
+ *
+ * Binary layout in code buffer (starting at code_buf):
+ *   [0..3]   export_vec_offset (uint32) — offset from code_buf to export_vec
+ *   [4..7]   code_size (uint32) — size of raw TCG bytecodes (incl. epilogue)
+ *   [8..8+code_size-1]   raw TCG wasm bytecodes + epilogue
+ *   [8+code_size..+3]    header_size (uint32)
+ *   [...]                header_bytes (wasm module prefix: magic through prologue)
+ *   [...]                import_vec_size (uint32) — byte size of import_vec
+ *   [...]                import_vec (uint32[]) — helper func_id values
+ *   [...]                export_vec_size (uint32) — currently 0 (unused)
+ *   [...]                export_vec — empty
+ */
+void wasm_finalize_module(TCGContext *s)
+{
+    WasmModuleState *ws = get_wasm_state(s);
+    uint8_t *code_buf = s->code_buf;
+
+    /* --- Step 1: Append epilogue to the raw bytecodes --- */
+    /*
+     * Epilogue closes the control flow structure:
+     *   end   ;; close last label's if block
+     *   end   ;; close dispatch loop
+     *   i32.const 0  ;; default return value
+     *   end   ;; function end (0x0b)
+     */
+    tcg_out8(s, 0x0b); /* end — close last if */
+    tcg_out8(s, 0x0b); /* end — close loop */
+    tcg_out8(s, 0x41); /* i32.const */
+    tcg_out8(s, 0x00); /* 0 */
+    tcg_out8(s, 0x0b); /* end — function end */
+
+    /* code region: bytes [8 .. code_ptr) */
+    uint8_t *code_begin = code_buf + 8;
+    uint32_t code_size = (uint32_t)(s->code_ptr - code_begin);
+
+    /* --- Step 2: Build wasm module header into a temp buffer --- */
+    /*
+     * We build the complete wasm module header (everything before the
+     * function body bytecodes) into a temporary buffer, then append it
+     * to the code buffer after the TCG bytecodes.
+     *
+     * Header includes: magic, version, type section, import section,
+     * function section, global section, export section, and the code
+     * section prefix (section header + func body header + locals + prologue).
+     */
+    int num_helpers = ws->num_helpers;
+    int helper_types_size = ws->helper_types_pos;
+
+    /* Max header size estimate:
+     * magic(4) + version(4) + type_sec(~64KB) + import_sec(~helpers*30+20) +
+     * func_sec(~10) + global_sec(25*5+10) + export_sec(~20) +
+     * code_sec_prefix(~200)
+     * Generously allocate: */
+    int max_header = 256 + helper_types_size + num_helpers * 32 + 200;
+    uint8_t *hdr = (uint8_t *)malloc(max_header);
+    if (!hdr) {
+        fprintf(stderr, "wasm_finalize_module: OOM\n");
+        return;
+    }
+    int hp = 0; /* header position */
+
+    /* Magic and version */
+    hdr[hp++] = 0x00; hdr[hp++] = 0x61; hdr[hp++] = 0x73; hdr[hp++] = 0x6d;
+    hdr[hp++] = 0x01; hdr[hp++] = 0x00; hdr[hp++] = 0x00; hdr[hp++] = 0x00;
+
+    /* --- Type Section (0x01) --- */
+    /* Types: index 0 = start func (i32)->(i32), then helper types */
+    {
+        uint8_t tsec[65536];
+        int tp = 0;
+        int num_types = 1 + num_helpers;
+        tp += write_leb128_u32(tsec + tp, num_types);
+
+        /* Type 0: (i32) -> (i32) — the start function */
+        tsec[tp++] = 0x60; /* func type */
+        tsec[tp++] = 0x01; /* 1 param */
+        tsec[tp++] = 0x7f; /* i32 */
+        tsec[tp++] = 0x01; /* 1 result */
+        tsec[tp++] = 0x7f; /* i32 */
+
+        /* Helper function types (pre-built in ws->helper_types) */
+        memcpy(tsec + tp, ws->helper_types, helper_types_size);
+        tp += helper_types_size;
+
+        hp += write_wasm_section(hdr + hp, 0x01, tsec, tp);
+    }
+
+    /* --- Import Section (0x02) --- */
+    /*
+     * Imports: "env"."buffer" (QEMU's linear memory) and "env"."table"
+     * (QEMU's __indirect_function_table).
+     *
+     * Helpers are not imported as functions: a C function pointer in wasm is
+     * an index into the function table, so the TB calls each helper with
+     * call_indirect on the imported table (see tcg_out_op_call_helper).
+     * That keeps helper calls wasm-to-wasm, with no host trampoline, and
+     * lets wasm exceptions thrown by helpers (siglongjmp) unwind straight
+     * through the TB to cpu_exec.  The helper types still occupy type
+     * indices 1..N for call_indirect's type check.
+     */
+    {
+        uint8_t isec[64];
+        int ip = 0;
+        ip += write_leb128_u32(isec + ip, 2); /* 2 imports */
+
+        /* Memory import: "env"."buffer" */
+        ip += write_leb128_u32(isec + ip, 3); /* "env" len */
+        isec[ip++] = 'e'; isec[ip++] = 'n'; isec[ip++] = 'v';
+        ip += write_leb128_u32(isec + ip, 6); /* "buffer" len */
+        isec[ip++] = 'b'; isec[ip++] = 'u'; isec[ip++] = 'f';
+        isec[ip++] = 'f'; isec[ip++] = 'e'; isec[ip++] = 'r';
+        isec[ip++] = 0x02; /* memory import */
+        isec[ip++] = 0x00; /* limits: no max */
+        ip += write_leb128_u32(isec + ip, 1); /* min pages = 1 */
+
+        /* Table import: "env"."table", funcref, min 1, no max */
+        ip += write_leb128_u32(isec + ip, 3); /* "env" len */
+        isec[ip++] = 'e'; isec[ip++] = 'n'; isec[ip++] = 'v';
+        ip += write_leb128_u32(isec + ip, 5); /* "table" len */
+        isec[ip++] = 't'; isec[ip++] = 'a'; isec[ip++] = 'b';
+        isec[ip++] = 'l'; isec[ip++] = 'e';
+        isec[ip++] = 0x01; /* table import */
+        isec[ip++] = 0x70; /* funcref */
+        isec[ip++] = 0x00; /* limits: no max */
+        ip += write_leb128_u32(isec + ip, 1); /* min elements = 1 */
+
+        hp += write_wasm_section(hdr + hp, 0x02, isec, ip);
+    }
+
+    /* --- Function Section (0x03) --- */
+    /* 1 function, type index 0 */
+    {
+        uint8_t fsec[8];
+        int fp = 0;
+        fsec[fp++] = 0x01; /* 1 function */
+        fsec[fp++] = 0x00; /* type index 0 */
+        hp += write_wasm_section(hdr + hp, 0x03, fsec, fp);
+    }
+
+    /* --- Global Section (0x06) --- */
+#ifndef WASI_PLATFORM
+    /* 25 globals: 24 virtual registers (i64 mut, init 0) + BLOCK_PTR_IDX */
+    {
+        uint8_t gsec[256];
+        int gp = 0;
+        gp += write_leb128_u32(gsec + gp, 25); /* 25 globals */
+        for (int i = 0; i < 25; i++) {
+            gsec[gp++] = 0x7e; /* i64 */
+            gsec[gp++] = 0x01; /* mutable */
+            gsec[gp++] = 0x42; /* i64.const */
+            gsec[gp++] = 0x00; /* 0 */
+            gsec[gp++] = 0x0b; /* end init expr */
+        }
+        hp += write_wasm_section(hdr + hp, 0x06, gsec, gp);
+    }
+#endif /* on WASI, the registers are locals (see REG_LOCAL_BASE) */
+
+    /* --- Export Section (0x07) --- */
+    /* Export "start": the only function, and nothing is imported, so 0 */
+    {
+        uint8_t esec[32];
+        int ep = 0;
+        esec[ep++] = 0x01; /* 1 export */
+        ep += write_leb128_u32(esec + ep, 5); /* "start" len */
+        esec[ep++] = 's'; esec[ep++] = 't'; esec[ep++] = 'a';
+        esec[ep++] = 'r'; esec[ep++] = 't';
+        esec[ep++] = 0x00; /* func export */
+        ep += write_leb128_u32(esec + ep, 0); /* func index */
+        hp += write_wasm_section(hdr + hp, 0x07, esec, ep);
+    }
+
+    /* --- Code Section (0x0a) --- */
+    /*
+     * We emit the code section header here, but the body bytes
+     * are split: prologue is in the header, raw TCG bytecodes are
+     * in code_begin..code_begin+code_size.
+     *
+     * The code section contains:
+     *   section_size (LEB128) — total of everything below
+     *   func_count (LEB128) = 1
+     *   body_size (LEB128) — local_decls + prologue + code_size
+     *   local_decls
+     *   prologue
+     *   [code bytes — NOT included here, they're in the code buffer]
+     *
+     * Since compile_and_cache_tb concatenates header + code,
+     * we include the code section header + locals + prologue in the header,
+     * and the raw bytecodes (already including epilogue) are the "code" part.
+     */
+
+    /* Build prologue bytes first */
+    uint8_t prologue[128];
+    int pp = 0;
+
+#ifdef WASI_PLATFORM
+    /*
+     * Local declarations: 2 x i32 (TMP32_LOCAL_ENV_IDX=1, TMP32_LOCAL_0_IDX=2),
+     * then 30 x i64: TMP64_0..TMP64_4 (indices 3..7) and the register file
+     * (REG_LOCAL_BASE = 8): R0-R15, A0-A7 and BLOCK_PTR (index 8 + 24 = 32).
+     */
+    prologue[pp++] = 0x02; /* 2 local declaration groups */
+    prologue[pp++] = 0x02; /* count: 2 */
+    prologue[pp++] = 0x7f; /* type: i32 */
+    prologue[pp++] = 5 + 25; /* count: 30 */
+    prologue[pp++] = 0x7e; /* type: i64 */
+
+    /*
+     * Every call starts at the TB's first instruction (see REG_LOCAL_BASE):
+     * load env and the call stack pointer.  BLOCK_PTR starts at 0, as do
+     * all locals.
+     */
+    prologue[pp++] = 0x20; prologue[pp++] = 0x00; /* local.get 0 (ctx) */
+    prologue[pp++] = 0x28; prologue[pp++] = 0x02; /* i32.load align=4 */
+    pp += write_leb128_u32(prologue + pp, 0); /* ENV_OFF */
+    prologue[pp++] = 0xad; /* i64.extend_i32_u */
+    prologue[pp++] = 0x21; prologue[pp++] = 8 + 14; /* local.set TCG_AREG0 */
+
+    prologue[pp++] = 0x20; prologue[pp++] = 0x00; /* local.get 0 */
+    prologue[pp++] = 0x28; prologue[pp++] = 0x02; /* i32.load align=4 */
+    pp += write_leb128_u32(prologue + pp, 4); /* STACK_OFF */
+    prologue[pp++] = 0xad; /* i64.extend_i32_u */
+    prologue[pp++] = 0x21; prologue[pp++] = 8 + 15; /* local.set TCG_REG_CALL_STACK */
+#else
+    /* Local declarations: 2 groups */
+    /* Group 1: 2 x i32 (TMP32_LOCAL_ENV_IDX=1, TMP32_LOCAL_0_IDX=2) */
+    /* Group 2: 5 x i64 (TMP64_0..TMP64_4, indices 3..7) */
+    prologue[pp++] = 0x02; /* 2 local declaration groups */
+    prologue[pp++] = 0x02; /* count: 2 */
+    prologue[pp++] = 0x7f; /* type: i32 */
+    prologue[pp++] = 0x05; /* count: 5 */
+    prologue[pp++] = 0x7e; /* type: i64 */
+
+    /* do_init check: load ctx->do_init, conditionally init registers */
+    prologue[pp++] = 0x20; prologue[pp++] = 0x00; /* local.get 0 (ctx) */
+    prologue[pp++] = 0x28; /* i32.load */
+    prologue[pp++] = 0x02; /* align=4 */
+    pp += write_leb128_u32(prologue + pp, 16); /* DO_INIT_OFF */
+    prologue[pp++] = 0x04; prologue[pp++] = 0x40; /* if (void) */
+
+    /* ctx->env -> global 14 (TCG_AREG0) */
+    prologue[pp++] = 0x20; prologue[pp++] = 0x00; /* local.get 0 */
+    prologue[pp++] = 0x28; prologue[pp++] = 0x02; /* i32.load align=4 */
+    pp += write_leb128_u32(prologue + pp, 0); /* ENV_OFF */
+    prologue[pp++] = 0xad; /* i64.extend_i32_u */
+    prologue[pp++] = 0x24; pp += write_leb128_u32(prologue + pp, 14); /* global.set 14 */
+
+    /* ctx->stack -> global 15 (TCG_REG_CALL_STACK) */
+    prologue[pp++] = 0x20; prologue[pp++] = 0x00; /* local.get 0 */
+    prologue[pp++] = 0x28; prologue[pp++] = 0x02; /* i32.load align=4 */
+    pp += write_leb128_u32(prologue + pp, 4); /* STACK_OFF */
+    prologue[pp++] = 0xad; /* i64.extend_i32_u */
+    prologue[pp++] = 0x24; pp += write_leb128_u32(prologue + pp, 15); /* global.set 15 */
+
+    /* BLOCK_PTR_IDX = 0 */
+    prologue[pp++] = 0x42; prologue[pp++] = 0x00; /* i64.const 0 */
+    prologue[pp++] = 0x24; pp += write_leb128_u32(prologue + pp, 24); /* global.set 24 */
+
+    prologue[pp++] = 0x0b; /* end if */
+#endif
+
+    /*
+     * Dispatch loop, then the guard for block 0.
+     *
+     * Every later block is guarded by "if (BLOCK_PTR <= idx)", so a branch
+     * that sets BLOCK_PTR and re-enters this loop skips the blocks before
+     * its target.  Block 0 must be guarded the same way.  It used to be
+     * "if (1)", so any backward branch re-ran block 0, repeating its side
+     * effects.  x86 "rep" string ops branch backwards to their exit label
+     * once ECX reaches 0, so code like "push; push; push; ...; rep movsl"
+     * pushed twice and later returned to a bogus address.
+     */
+    prologue[pp++] = 0x03; prologue[pp++] = 0x40; /* loop (void) */
+#ifdef WASI_PLATFORM
+    prologue[pp++] = 0x20; prologue[pp++] = 8 + 24; /* local.get BLOCK_PTR */
+#else
+    prologue[pp++] = 0x23; pp += write_leb128_u32(prologue + pp, 24); /* global.get BLOCK_PTR */
+#endif
+    prologue[pp++] = 0x42; prologue[pp++] = 0x00; /* i64.const 0 */
+    prologue[pp++] = 0x58; /* i64.le_u */
+    prologue[pp++] = 0x04; prologue[pp++] = 0x40; /* if (void) */
+
+    int prologue_size = pp;
+
+    /* Now build the code section header */
+    /* body_size = prologue_size + code_size (code_size includes epilogue) */
+    uint32_t body_size = prologue_size + code_size;
+
+    uint8_t code_sec_prefix[32];
+    int csp = 0;
+
+    /* func_count = 1 */
+    csp += write_leb128_u32(code_sec_prefix + csp, 1);
+    /* body_size */
+    csp += write_leb128_u32(code_sec_prefix + csp, body_size);
+
+    /* section_size = code_sec_prefix + prologue + code_size */
+    uint32_t section_size = csp + prologue_size + code_size;
+
+    /* Write code section header */
+    hdr[hp++] = 0x0a; /* code section id */
+    hp += write_leb128_u32(hdr + hp, section_size);
+    memcpy(hdr + hp, code_sec_prefix, csp);
+    hp += csp;
+    memcpy(hdr + hp, prologue, prologue_size);
+    hp += prologue_size;
+
+    /* Header is complete. hp = total header size */
+    int header_size = hp;
+
+    /* --- Step 3: Write metadata after code bytes in the code buffer --- */
+
+    uint8_t *out = s->code_ptr; /* current position = right after epilogue */
+
+    /* header_size (uint32) */
+    memcpy(out, &header_size, 4);
+    out += 4;
+
+    /* header_bytes */
+    memcpy(out, hdr, header_size);
+    out += header_size;
+
+    free(hdr);
+
+    /* import_vec: helper func_id values (uint32 each) */
+    uint32_t import_vec_byte_size = num_helpers * 4;
+    memcpy(out, &import_vec_byte_size, 4);
+    out += 4;
+    for (int i = 0; i < num_helpers; i++) {
