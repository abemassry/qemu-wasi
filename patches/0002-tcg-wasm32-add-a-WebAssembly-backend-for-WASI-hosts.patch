+        tcg_out_op_global_get_r_i32(s, base);
+        if ((int32_t)offset < 0) {
+            tcg_out_op_i32_const(s, (int32_t)offset);
+            tcg_out_op_i32_add(s);
+            offset = 0;
+        }
+        tcg_out_op_global_get_r(s, val);
+        tcg_out_op_i64_store32(s, 0, (uint32_t)offset);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+}
