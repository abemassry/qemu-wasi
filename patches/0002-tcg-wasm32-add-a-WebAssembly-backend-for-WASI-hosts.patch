+
+struct wasmContext {
+    // 0
+    CPUArchState *env;
+    // 4
+    uint64_t *stack;
+    // 8
+    uint32_t *tb_ptr;
+    // 12
+    uint32_t *tci_tb_ptr;
+    // 16
+    uint32_t do_init;
+    // 20
+    uint32_t done_flag;
+    // 24
+    uint64_t *stack128;
+    // 28
+    uint32_t unwinding;
+};
