+     *
+     * This is safe because WASI is single-threaded and the BH callback
+     * just calls the real (non-coroutine) function and stores the result.
+     */
+    if (qemu_in_coroutine()) {
+        cb(opaque);
+        return;
+    }
+#endif
     QEMUBH *bh;
     bh = g_new(QEMUBH, 1);
     *bh = (QEMUBH){
@@ -684,6 +699,19 @@ void coroutine_fn aio_co_reschedule_self(AioContext *new_ctx)
 
 void aio_co_wake(Coroutine *co)
 {
+#ifdef WASI_PLATFORM
+    /*
+     * WASI synchronous coroutine support: when the BH callback ran
+     * inline (via aio_bh_schedule_oneshot_full), it calls aio_co_wake(co)
+     * to "resume" the coroutine. But the coroutine is already running
+     * (it hasn't actually yielded yet — yield comes after the BH).
+     * So if co == self, just return — the coroutine will continue
+     * after qemu_coroutine_yield() returns.
+     */
+    if (co == qemu_coroutine_self()) {
+        return;
+    }
+#endif
     AioContext *ctx;
 
     /* Read coroutine before co->ctx.  Matches smp_wmb in
