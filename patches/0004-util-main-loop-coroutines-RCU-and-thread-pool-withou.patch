 util/rcu.c               | 35 ++++++++++++++++++++++++
 util/thread-pool.c       | 10 +++++++
 7 files changed, 166 insertions(+)

diff --git a/block/graph-lock.c b/block/graph-lock.c
index c81162b..d100f4e 100644
--- a/block/graph-lock.c
+++ b/block/graph-lock.c
@@ -110,6 +110,22 @@ void no_coroutine_fn bdrv_graph_wrlock(void)
 {
     GLOBAL_STATE_CODE();
     assert(!qatomic_read(&has_writer));
+#ifdef WASI_PLATFORM
+    /*
+     * WASI runs a bottom half scheduled from a coroutine inline, inside that
+     * coroutine (see aio_bh_schedule_oneshot_full()).  So the generated
+     * wrappers of no_co_wrapper_bdrv_wrlock functions, such as
+     * bdrv_co_unref_child() on the error path of qcow2_do_open(), get here
+     * in coroutine context.  The coroutine dropped its read lock before
+     * scheduling and there is only one thread, so nothing is reading the
+     * graph: take the lock without the drain and wait, which a coroutine
+     * cannot do.
+     */
+    if (qemu_in_coroutine()) {
+        qatomic_set(&has_writer, 1);
+        return;
+    }
+#endif
     assert(!qemu_in_coroutine());
 
     /* Make sure that constantly arriving new I/O doesn't cause starvation */
diff --git a/include/qemu/main-loop.h b/include/qemu/main-loop.h
index 5764db1..d9f9a5e 100644
--- a/include/qemu/main-loop.h
+++ b/include/qemu/main-loop.h
@@ -91,6 +91,16 @@ int qemu_init_main_loop(Error **errp);
  */
 void main_loop_wait(int nonblocking);
 
+#ifdef WASI_PLATFORM
+/*
+ * How main_loop_wait() sleeps while every vCPU is idle (WASI has no fds to
+ * poll): wait up to the given number of nanoseconds.  NULL means a plain
+ * nanosleep(); a backend that can tell when work arrives sets a function
+ * that returns early instead.
+ */
+extern void (*wasi_idle_wait)(int64_t ns);
+#endif
+
 /**
  * qemu_get_aio_context: Return the main loop's AioContext
  */
diff --git a/include/qemu/rcu.h b/include/qemu/rcu.h
index fea058a..1215cd9 100644
--- a/include/qemu/rcu.h
+++ b/include/qemu/rcu.h
@@ -143,6 +143,15 @@ struct rcu_head {
 void call_rcu1(struct rcu_head *head, RCUCBFunc *func);
 void drain_call_rcu(void);
 
+#ifdef __wasi__
+/*
+ * Run the callbacks queued by call_rcu() so far.  WASI builds have no
+ * threads, so the main loop calls this between iterations in place of the
+ * call_rcu thread.
+ */
+void rcu_run_callbacks_inline(void);
+#endif
+
 /* The operands of the minus operator must have the same type,
  * which must be the one that we specify in the cast.
  */
