@@ -586,10 +601,53 @@ void main_loop_wait(int nonblocking)
                                       timerlistgroup_deadline_ns(
                                           &main_loop_tlg));
 
+#ifdef WASI_PLATFORM
+    /*
+     * g_poll() is a stub on WASI (glib-wasi) and never waits.  When the
+     * caller is willing to block -- the WASI main loop only asks when every
+     * vCPU is idle -- sleep until the next timer deadline here instead of
+     * spinning.  Cap the sleep: host input is polled from the display
+     * refresh, and a guest interrupt may also be raised by a device.
+     */
+    if (!nonblocking) {
+        const int64_t max_idle_ns = 10 * SCALE_MS;
+        int64_t ns = timeout_ns < 0 ? max_idle_ns : MIN(timeout_ns, max_idle_ns);
+
+        if (ns > 0) {
+            extern void wasi_prof_add_idle(int64_t ns);
+            int64_t t = get_clock();
+
+            if (wasi_idle_wait) {
+                wasi_idle_wait(ns);
+            } else {
+                struct timespec ts = { .tv_sec = 0, .tv_nsec = ns };
+
+                nanosleep(&ts, NULL);
+            }
+            wasi_prof_add_idle(get_clock() - t);
+        }
+    }
+#endif
+
     ret = os_host_main_loop_wait(timeout_ns);
     mlpoll.state = ret < 0 ? MAIN_LOOP_POLL_ERR : MAIN_LOOP_POLL_OK;
     notifier_list_notify(&main_loop_poll_notifiers, &mlpoll);
 
+#ifdef WASI_PLATFORM
+    /*
+     * QEMU normally services its AioContexts as GSources dispatched by the
+     * glib main context.  glib-wasi's GMainContext is a stub that never
+     * dispatches attached sources, so without this nothing would run main
+     * context bottom halves, fd handlers or AioContext timers.  Device
+     * models depend on those: e.g. the IDE software-reset completion
+     * (ide_bus_perform_srst) and blk_aio_prwv()'s completion callback are
+     * both bottom halves, so disk probing and every guest disk read would
+     * hang.  Poll both contexts directly, without blocking.
+     */
+    aio_poll(iohandler_get_aio_context(), false);
+    aio_poll(qemu_get_aio_context(), false);
+#endif
+
     if (icount_enabled()) {
         /*
          * CPU thread can infinitely wait for event after
diff --git a/util/rcu.c b/util/rcu.c
index fa32c94..40fb917 100644
--- a/util/rcu.c
+++ b/util/rcu.c
@@ -313,6 +313,41 @@ void call_rcu1(struct rcu_head *node, void (*func)(struct rcu_head *node))
     qemu_event_set(&rcu_call_ready_event);
 }
 
+#ifdef __wasi__
+/*
+ * WASI builds have no threads: the call_rcu thread is "created" but never
+ * runs (see wasi-stubs/pthread_stubs.c), so without this every callback
+ * would stay queued forever and leak whatever it frees -- old TB hash
+ * tables after each TB buffer flush, old FlatViews after each memory map
+ * change, and so on.
+ *
+ * Called by the main loop between iterations with the BQL held, as the
+ * call_rcu thread would run the callbacks.  This thread is the only RCU
+ * reader, so once it is outside any read-side critical section a grace
+ * period has elapsed for everything queued so far.
+ */
+void rcu_run_callbacks_inline(void)
+{
+    int n = qatomic_read(&rcu_call_count);
+
+    if (n == 0 || get_ptr_rcu_reader()->depth != 0) {
+        return;
+    }
+    qatomic_sub(&rcu_call_count, n);
+    while (n > 0) {
+        struct rcu_head *node = try_dequeue();
+
+        if (!node) {
+            /* Not reached: the count only covers enqueued nodes. */
+            qatomic_add(&rcu_call_count, n);
+            break;
+        }
+        n--;
+        node->func(node);
+    }
+}
+#endif
+
 
 struct rcu_drain {
     struct rcu_head rcu;
diff --git a/util/thread-pool.c b/util/thread-pool.c
index 27eb777..1d396ef 100644
--- a/util/thread-pool.c
+++ b/util/thread-pool.c
@@ -283,11 +283,21 @@ static void thread_pool_co_cb(void *opaque, int ret)
 
 int coroutine_fn thread_pool_submit_co(ThreadPoolFunc *func, void *arg)
 {
+#ifdef WASI_PLATFORM
+    /*
+     * WASI is single-threaded — no worker threads exist.
+     * Execute the work function synchronously instead of submitting
+     * to the thread pool and yielding (which would abort).
+     * The work function (e.g. handle_aiocb_rw) is just a pread/pwrite wrapper.
+     */
+    return func(arg);
+#else
     ThreadPoolCo tpc = { .co = qemu_coroutine_self(), .ret = -EINPROGRESS };
     assert(qemu_in_coroutine());
     thread_pool_submit_aio(func, arg, thread_pool_co_cb, &tpc);
     qemu_coroutine_yield();
     return tpc.ret;
+#endif
 }
 
 void thread_pool_submit(ThreadPoolFunc *func, void *arg)
